<https://ontologies.corestory.ai/sao/export/values/DataPipelineType/streaming> rdf:value "streaming" .

<https://ontologies.corestory.ai/sao/export/values/DataPipelineType/training> rdf:value "training" .

<https://ontologies.corestory.ai/sao/export/values/MLModelType/anomaly_detection> rdf:value "anomaly_detection" .

<https://ontologies.corestory.ai/sao/export/values/MLModelType/classification> rdf:value "classification" .

<https://ontologies.corestory.ai/sao/export/values/MLModelType/clustering> rdf:value "clustering" .

