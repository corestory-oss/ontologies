<https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values> rdf:first "local_state" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/1> rdf:first "global_store" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/2> .

