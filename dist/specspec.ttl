        spec:SpecActivity,
        spec:SpecAgent,
        spec:SpecElement,
        spec:Specification,
        spec:SpecificationArtifact,
        spec:UseCase,
        spec:VerificationResult ;
    rdfs:comment "[AcceptanceCriterion] Short human-readable title.",
        "[ArtifactFragment] Short human-readable title.",
        "[ChangeProposal] Short human-readable title.",
        "[Claim] Short human-readable title.",
        "[DecisionOption] Short human-readable title.",
        "[Decision] Short human-readable title.",
        "[EvidenceAnchor] Short human-readable title.",
        "[RepresentationProfile] Short human-readable title.",
        "[RequirementReplacement] Short human-readable title.",
        "[Requirement] Short human-readable title.",
        "[ScenarioStep] Short human-readable title.",
