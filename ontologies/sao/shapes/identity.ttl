<https://ontologies.corestory.ai/sao/shapes/Actor/audit_actions_performed> a sh:PropertyShape ;
    sh:class sao:AuditEntry ;
    sh:description "`AuditEntry` entities recording actions by this actor." ;
    sh:path sao:audit_actions_performed .

<https://ontologies.corestory.ai/sao/shapes/Actor/category> a sh:PropertyShape ;
    sh:description "Actor category (`human`, `system`)." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Actor/category/values> ;
    sh:maxCount 1 ;
    sh:path sao:category .

<https://ontologies.corestory.ai/sao/shapes/Actor/category/values> rdf:first "human" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Actor/category/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Actor/category/values/cell/1> rdf:first "system" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Actor/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Actor/has_identities> a sh:PropertyShape ;
    sh:class sao:Identity ;
    sh:description "One or more `Identity` entities associated with this actor." ;
    sh:path sao:has_identities .

<https://ontologies.corestory.ai/sao/shapes/Actor/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Actor/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Actor/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Actor/owns_controls> a sh:PropertyShape ;
    sh:class sao:Control ;
    sh:description "`Control` entities owned by this actor." ;
    sh:path sao:owns_controls .

<https://ontologies.corestory.ai/sao/shapes/Actor/owns_subscriptions> a sh:PropertyShape ;
    sh:class sao:Subscription ;
    sh:description "`Subscription` entities owned by this actor." ;
    sh:path sao:owns_subscriptions .

<https://ontologies.corestory.ai/sao/shapes/Actor/performs_actions> a sh:PropertyShape ;
    sh:class sao:Action ;
    sh:description "`Action` entities performed by this actor." ;
    sh:path sao:performs_actions .

<https://ontologies.corestory.ai/sao/shapes/Actor/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Actor/verifies_evidence> a sh:PropertyShape ;
    sh:class sao:Evidence ;
    sh:description "`Evidence` entities verified by this actor." ;
    sh:path sao:verifies_evidence .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_for_identity> a sh:PropertyShape ;
    sh:class sao:Identity ;
    sh:maxCount 1 ;
    sh:path sao:credential_for_identity .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type> a sh:PropertyShape ;
    sh:description "Type of credential." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:credential_type .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values> rdf:first "password" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/1> rdf:first "token" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/2> rdf:first "certificate" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/3> rdf:first "api_key" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/4> rdf:first "biometric" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/5> rdf:first "mfa" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/Credential/credential_type/values/cell/6> rdf:first "oauth" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Credential/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Credential/expires_at> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Expiration timestamp." ;
    sh:maxCount 1 ;
    sh:path sao:expires_at .

<https://ontologies.corestory.ai/sao/shapes/Credential/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Credential/is_active> a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:description "Whether the credential is currently active." ;
    sh:maxCount 1 ;
    sh:path sao:is_active .

<https://ontologies.corestory.ai/sao/shapes/Credential/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Credential/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Credential/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/HumanActor/actor_type> a sh:PropertyShape ;
