    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/entity_documented_by_artifacts> a sh:PropertyShape ;
    sh:class sao:KnowledgeArtifact ;
    sh:path sao:entity_documented_by_artifacts .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/exposes_as_resource> a sh:PropertyShape ;
    sh:class sao:Resource ;
    sh:description "`Resource` entities that expose this entity externally." ;
    sh:path sao:exposes_as_resource .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/governed_by_lifecycle> a sh:PropertyShape ;
    sh:class sao:Lifecycle ;
    sh:description "`Lifecycle` defining valid states and transitions." ;
    sh:maxCount 1 ;
    sh:path sao:governed_by_lifecycle .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/governed_by_rules> a sh:PropertyShape ;
    sh:class sao:Rule ;
    sh:description "`Rule` entities governing this entity." ;
    sh:path sao:governed_by_rules .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/has_incoming_relationships> a sh:PropertyShape ;
    sh:class sao:DomainRelationship ;
    sh:description "`DomainRelationship` entities where this entity is the target." ;
    sh:path sao:has_incoming_relationships .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/has_outgoing_relationships> a sh:PropertyShape ;
    sh:class sao:DomainRelationship ;
    sh:description "`DomainRelationship` entities where this entity is the source." ;
    sh:path sao:has_outgoing_relationships .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/in_state> a sh:PropertyShape ;
    sh:class sao:State ;
    sh:description "Current `State` in the lifecycle." ;
    sh:maxCount 1 ;
    sh:path sao:in_state .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/is_root_of_aggregate> a sh:PropertyShape ;
    sh:class sao:Aggregate ;
