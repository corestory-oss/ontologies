    rdfs:comment "[Scenario] Requirements illustrated by this scenario." ;
    rdfs:domain spec:Scenario ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:Requirement .

spec:input_elements a rdf:Property ;
    rdfs:label "input_elements" ;
    rdfs:comment "[SpecActivity] Specification knowledge consumed by the activity." ;
    rdfs:domain spec:SpecActivity ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:SpecElement .

spec:input_snapshots a rdf:Property ;
    rdfs:label "input_snapshots" ;
    rdfs:comment "[SpecActivity] Source states consumed by the activity." ;
    rdfs:domain spec:SpecActivity ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:SourceSnapshot .

spec:justification_claims a rdf:Property ;
    rdfs:label "justification_claims" ;
    rdfs:comment "[RequirementReplacement] Reasons for replacing the requirement." ;
    rdfs:domain spec:RequirementReplacement ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:Claim .

spec:line_end a rdf:Property ;
    rdfs:label "line_end" ;
    rdfs:comment "[EvidenceAnchor] Inclusive last line; must be at least line_start." ;
    rdfs:domain spec:EvidenceAnchor ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:integer .

spec:line_start a rdf:Property ;
    rdfs:label "line_start" ;
    rdfs:comment "[EvidenceAnchor] Inclusive one-based first line, when the source is line-oriented." ;
    rdfs:domain spec:EvidenceAnchor ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:integer .

spec:media_type a rdf:Property ;
    rdfs:label "media_type" ;
    rdfs:comment "[SourceSnapshot] Media type of the captured source, when relevant." ;
    rdfs:domain spec:SourceSnapshot ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:string .

spec:model_identifier a rdf:Property ;
    rdfs:label "model_identifier" ;
    rdfs:comment "[SpecActivity] Model and version used for inference, if applicable." ;
    rdfs:domain spec:SpecActivity ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:string .

spec:options a rdf:Property ;
    rdfs:label "options" ;
    rdfs:comment "[Decision] Alternatives considered." ;
    rdfs:domain spec:Decision ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:DecisionOption .

spec:origin a rdf:Property ;
    rdfs:label "origin" ;
    schema1:domainIncludes spec:AcceptanceCriterion,
        spec:Claim,
        spec:Requirement ;
    rdfs:comment "[AcceptanceCriterion] How this statement was obtained.",
        "[Claim] How this statement was obtained.",
        "[Requirement] How this statement was obtained." ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:OriginMode .

spec:outcome a rdf:Property ;
    rdfs:label "outcome" ;
    rdfs:comment "[VerificationResult] Observed check outcome." ;
    rdfs:domain spec:VerificationResult ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:VerificationOutcome .

spec:outcomes a rdf:Property ;
    rdfs:label "outcomes" ;
    rdfs:comment "[Scenario] Statements of observed or intended outcomes." ;
    rdfs:domain spec:Scenario ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:Claim .

spec:parameters a rdf:Property ;
    rdfs:label "parameters" ;
    rdfs:comment "[SpecActivity] Recorded configuration or a URI to the immutable configuration." ;
    rdfs:domain spec:SpecActivity ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:string .

spec:participant a rdf:Property ;
    rdfs:label "participant" ;
    rdfs:comment "[ScenarioStep] Narrative role performing this interaction." ;
    rdfs:domain spec:ScenarioStep ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:string .

spec:participants a rdf:Property ;
    rdfs:label "participants" ;
    rdfs:comment "[UseCase] Roles participating in this interaction." ;
