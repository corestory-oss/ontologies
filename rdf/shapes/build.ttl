    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/size_bytes> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Size in bytes." ;
    sh:maxCount 1 ;
    sh:path sao:size_bytes .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/version> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Semantic version." ;
    sh:maxCount 1 ;
    sh:path sao:version ;
    sh:pattern "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$" .

