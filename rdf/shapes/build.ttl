@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix saosh: <https://ontologies.corestory.ai/sao/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

saosh:ArtifactRegistryShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/base_url>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/description>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/id>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/is_private>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/name>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/registry_type>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/stores_artifacts>,
        <https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/tags> ;
    sh:targetClass sao:ArtifactRegistry .

saosh:BuildArtifactShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_produced_by_pipeline>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_stored_in_registry>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_uri>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/build_number>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/checksum>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/description>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/effective_from>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/effective_to>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/id>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/is_current>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/name>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/size_bytes>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/tags>,
        <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/version> ;
    sh:targetClass sao:BuildArtifact .

saosh:BuildPipelineShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/description>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/has_stages>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/id>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/is_parallelizable>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/name>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/pipeline_deploys_to_environments>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/pipeline_produces_artifacts>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/pipeline_type>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/pipeline_uses_iac>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/platform>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/source_file>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/tags>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/timeout_minutes>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/trigger>,
        <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/trigger_branches> ;
    sh:targetClass sao:BuildPipeline .

saosh:PipelineStageShape a sh:NodeShape ;
    sh:closed false ;
