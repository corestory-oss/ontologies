<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns> a sh:PropertyShape ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values> ;
    sh:path sao:architectural_patterns .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values> rdf:first "cqrs" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/1> rdf:first "event_sourcing" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/10> rdf:first "bff" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/11> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/11> rdf:first "api_gateway" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/12> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/12> rdf:first "sidecar" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/13> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/13> rdf:first "event_driven" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/14> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/14> rdf:first "batch_sequential" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/15> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/15> rdf:first "transaction_script" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/16> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/16> rdf:first "table_module" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/17> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/17> rdf:first "domain_model" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/18> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/18> rdf:first "repository" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/19> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/19> rdf:first "plugin" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/2> rdf:first "hexagonal" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/3> rdf:first "clean_architecture" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/4> rdf:first "layered" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/5> rdf:first "microservice" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/6> rdf:first "modular_monolith" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/7> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/7> rdf:first "pipe_and_filter" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/8> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/8> rdf:first "saga" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/9> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/9> rdf:first "strangler_fig" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BoundedContext/architectural_patterns/values/cell/10> .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/contained_in_system> a sh:PropertyShape ;
    sh:class sao:System ;
    sh:description "The parent system." ;
    sh:maxCount 1 ;
    sh:path sao:contained_in_system .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/contains_aggregates> a sh:PropertyShape ;
    sh:class sao:Aggregate ;
    sh:description "Aggregates within this bounded context." ;
    sh:path sao:contains_aggregates .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/contains_modules> a sh:PropertyShape ;
    sh:class sao:Module ;
    sh:description "Modules within this bounded context." ;
    sh:path sao:contains_modules .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/context_documented_by_artifacts> a sh:PropertyShape ;
    sh:class sao:KnowledgeArtifact ;
    sh:path sao:context_documented_by_artifacts .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/context_map_relationship> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Relationship pattern (e.g., Customer-Supplier, Partnership)" ;
    sh:maxCount 1 ;
    sh:path sao:context_map_relationship .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/downstream_from> a sh:PropertyShape ;
    sh:class sao:BoundedContext ;
    sh:description "Bounded contexts that depend on this one." ;
    sh:path sao:downstream_from .

<https://ontologies.corestory.ai/sao/shapes/BoundedContext/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

