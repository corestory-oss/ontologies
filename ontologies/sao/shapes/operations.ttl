@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix saosh: <https://ontologies.corestory.ai/sao/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

saosh:ConfigurationShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Configuration/config_type>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/configures_deployments>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/configures_environments>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/controls_features>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/description>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/id>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/is_secret>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/name>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/setting_for_tenant>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/source>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Configuration/value> ;
    sh:targetClass sao:Configuration .

saosh:DeploymentShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Deployment/deployed_in_environment>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/deployment_configured_by>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/deploys_release>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/deploys_service>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/deploys_unit>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/description>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/id>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/name>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/replicas>,
        <https://ontologies.corestory.ai/sao/shapes/Deployment/tags> ;
    sh:targetClass sao:Deployment .

saosh:DeploymentUnitShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/DeploymentUnit/artifact_uri>,
        <https://ontologies.corestory.ai/sao/shapes/DeploymentUnit/checksum>,
        <https://ontologies.corestory.ai/sao/shapes/DeploymentUnit/deployed_in_deployments>,
        <https://ontologies.corestory.ai/sao/shapes/DeploymentUnit/description>,
