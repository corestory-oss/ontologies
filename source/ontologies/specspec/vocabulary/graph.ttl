@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spec: <https://ontologies.corestory.ai/specspec/> .

spec:SpecificationGraph a rdfs:Class ;
    rdfs:label "SpecificationGraph" ;
    rdfs:comment "An exchange envelope containing identified knowledge items and their references. Sources and software graphs may be stored separately." ;
    rdfs:isDefinedBy spec: .

spec:activities a rdf:Property ;
    rdfs:label "activities" ;
    rdfs:comment "[SpecificationGraph] Inline records of SpecActivity items; relationships between records use their identifiers." ;
    rdfs:domain spec:SpecificationGraph ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:SpecActivity .

spec:agents a rdf:Property ;
    rdfs:label "agents" ;
    rdfs:comment "[SpecificationGraph] Inline records of SpecAgent items; relationships between records use their identifiers." ;
    rdfs:domain spec:SpecificationGraph ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:SpecAgent .

spec:anchors a rdf:Property ;
    rdfs:label "anchors" ;
    rdfs:comment "[SpecificationGraph] Inline records of EvidenceAnchor items; relationships between records use their identifiers." ;
    rdfs:domain spec:SpecificationGraph ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:EvidenceAnchor .

