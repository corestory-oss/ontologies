sao:OwnershipModel a rdfs:Datatype ;
    rdfs:label "OwnershipModel" ;
    rdfs:comment "Memory ownership models" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/borrowed_mutable>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/borrowed_shared>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/copied>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/garbage_collected>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/manual>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/moved>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/owned>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/reference_counted>,
        <https://ontologies.corestory.ai/sao/export/values/OwnershipModel/stack_allocated> .

sao:DataClassificationType a rdfs:Datatype ;
    rdfs:label "DataClassificationType" ;
    rdfs:comment "Data sensitivity classifications" ;
