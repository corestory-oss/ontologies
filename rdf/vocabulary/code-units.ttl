    rdfs:domain sao:DataElement ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:TypeExpression .

sao:direction a rdf:Property ;
    rdfs:label "direction" ;
    rdfs:comment "Direction (range: `ParameterDirection`): `input`, `output`, `input_output`, `return`.",
        "[Parameter] Direction (range: `ParameterDirection`): `input`, `output`, `input_output`, `return`." ;
    rdfs:domain sao:Parameter ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:ParameterDirection .

