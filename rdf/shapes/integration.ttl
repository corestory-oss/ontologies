saosh:MessageShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Message/description>,
        <https://ontologies.corestory.ai/sao/shapes/Message/id>,
        <https://ontologies.corestory.ai/sao/shapes/Message/message_structured_by_schema>,
        <https://ontologies.corestory.ai/sao/shapes/Message/message_type>,
        <https://ontologies.corestory.ai/sao/shapes/Message/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Message/name>,
