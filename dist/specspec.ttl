spec:title a rdf:Property ;
    rdfs:label "title" ;
    schema1:domainIncludes spec:AcceptanceCriterion,
        spec:ArtifactFragment,
        spec:ChangeProposal,
        spec:Claim,
        spec:Decision,
        spec:DecisionOption,
        spec:EvidenceAnchor,
