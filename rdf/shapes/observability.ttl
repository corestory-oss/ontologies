    sh:targetClass sao:Incident .

saosh:LogEntryShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/LogEntry/context>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/description>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/entry_in_log>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/id>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/level>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/message>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/name>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/tags>,
        <https://ontologies.corestory.ai/sao/shapes/LogEntry/timestamp> ;
    sh:targetClass sao:LogEntry .

saosh:LogShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Log/contains_entries>,
        <https://ontologies.corestory.ai/sao/shapes/Log/description>,
        <https://ontologies.corestory.ai/sao/shapes/Log/id>,
        <https://ontologies.corestory.ai/sao/shapes/Log/log_governed_by_retention>,
        <https://ontologies.corestory.ai/sao/shapes/Log/log_type>,
        <https://ontologies.corestory.ai/sao/shapes/Log/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Log/name>,
        <https://ontologies.corestory.ai/sao/shapes/Log/tags> ;
    sh:targetClass sao:Log .

saosh:MetricShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Metric/description>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/id>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/labels>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/metric_emitted_by_component>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/metric_type>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/monitored_by_alert_rules>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/name>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Metric/unit> ;
