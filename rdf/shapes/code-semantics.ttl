<https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type> a sh:PropertyShape ;
    sh:description "Type (sequential, conditional, loop, try_catch, transaction, critical_section, scope)." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:block_type .

<https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type/values> rdf:first "sequential" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type/values/cell/1> rdf:first "conditional" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type/values/cell/2> .

