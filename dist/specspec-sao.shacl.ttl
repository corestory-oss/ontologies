specsaosh:DescriptiveBasisConstraint a sh:SPARQLConstraint ;
    sh:message "An implementation link must cite a descriptive basis claim." ;
    sh:select """PREFIX spec: <https://ontologies.corestory.ai/specspec/>
PREFIX specsao: <https://ontologies.corestory.ai/specspec/sao/>
SELECT $this WHERE { $this specsao:basis_claim ?claim . FILTER NOT EXISTS { ?claim spec:statement_mode "descriptive" } }""" .

