    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/rate_limit> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Requests per minute limit." ;
    sh:maxCount 1 ;
    sh:path sao:rate_limit .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type> a sh:PropertyShape ;
    sh:description "Type of user-facing interface." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:ui_type .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values> rdf:first "web_ui" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values/cell/1> rdf:first "mobile_ui" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values/cell/2> rdf:first "desktop_ui" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/UserInterface/ui_type/values/cell/3> rdf:first "cli" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/belongs_to_aggregate> a sh:PropertyShape ;
    sh:class sao:Aggregate ;
    sh:maxCount 1 ;
    sh:path sao:belongs_to_aggregate .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/has_attributes> a sh:PropertyShape ;
    sh:class sao:Attribute ;
    sh:description "List of `Attribute` entities defining the value object." ;
    sh:path sao:has_attributes .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/mapped_from_structure_vo> a sh:PropertyShape ;
    sh:class sao:DataStructure ;
    sh:description "Back-reference to the `DataStructure` that maps to this value object." ;
    sh:path sao:mapped_from_structure_vo .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/ValueObject/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Versionable/effective_from> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Version start date." ;
    sh:maxCount 1 ;
    sh:path sao:effective_from .

<https://ontologies.corestory.ai/sao/shapes/Versionable/effective_to> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Version end date." ;
    sh:maxCount 1 ;
    sh:path sao:effective_to .

<https://ontologies.corestory.ai/sao/shapes/Versionable/is_current> a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:description "Whether this is the current version." ;
    sh:maxCount 1 ;
    sh:path sao:is_current .

<https://ontologies.corestory.ai/sao/shapes/Versionable/version> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Semantic version." ;
    sh:maxCount 1 ;
    sh:path sao:version ;
    sh:pattern "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$" .

<https://ontologies.corestory.ai/sao/shapes/Workflow/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Workflow/has_steps> a sh:PropertyShape ;
    sh:class sao:Step ;
    sh:description "Ordered list of `Step` entities." ;
    sh:path sao:has_steps .

<https://ontologies.corestory.ai/sao/shapes/Workflow/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Workflow/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Workflow/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Workflow/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Workflow/triggered_by_workflow_events> a sh:PropertyShape ;
    sh:class sao:Event ;
    sh:description "`Event` entities that start the workflow." ;
    sh:path sao:triggered_by_workflow_events .

<https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type> a sh:PropertyShape ;
    sh:description "Coordination pattern." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:workflow_type .

<https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values> rdf:first "synchronous" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/1> rdf:first "asynchronous" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/2> rdf:first "saga" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/3> rdf:first "choreography" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Workflow/workflow_type/values/cell/4> rdf:first "orchestration" ;
    rdf:rest () .
