sao:KnownVulnerability a rdfs:Class ;
    rdfs:label "KnownVulnerability" ;
    rdfs:comment "A known security vulnerability in a dependency" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:PackageDependency a rdfs:Class ;
    rdfs:label "PackageDependency" ;
    rdfs:comment "A declared dependency on an external package or library" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:PackageManager a rdfs:Class ;
    rdfs:label "PackageManager" ;
    rdfs:comment "A package/dependency management tool" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:DependencyScope a rdfs:Datatype ;
    rdfs:label "DependencyScope" ;
    rdfs:comment "Scope/context of a dependency" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/DependencyScope/build>,
        <https://ontologies.corestory.ai/sao/export/values/DependencyScope/development>,
