saosh:AuditEntryShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/AuditEntry/affects_resource>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/audit_performed_by_actor>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/description>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/details>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/entry_in_audit_log>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/id>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/name>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/outcome>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/records_action>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/tags>,
        <https://ontologies.corestory.ai/sao/shapes/AuditEntry/timestamp> ;
    sh:targetClass sao:AuditEntry .

