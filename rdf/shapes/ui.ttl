<https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/3> rdf:first "url_state" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/4> rdf:first "server_state" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/StateStore/management_type/values/cell/5> rdf:first "form_state" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/StateStore/manages_ui_components> a sh:PropertyShape ;
    sh:class sao:UIComponent ;
    sh:description "UI components managed." ;
    sh:path sao:manages_ui_components .

