spec:profile a rdf:Property ;
    rdfs:label "profile" ;
    rdfs:comment "[SpecificationArtifact] Document convention used for this representation." ;
    rdfs:domain spec:SpecificationArtifact ;
    rdfs:isDefinedBy spec: ;
