@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix saosh: <https://ontologies.corestory.ai/sao/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

saosh:AlertRuleShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/AlertRule/action>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/category>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/condition>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/description>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/duration_seconds>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/enforces_aggregate_invariants>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/governs_domain_entities>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/guards_transitions>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/id>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/is_active>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/monitors_metrics>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/name>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/notification_channels>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/priority>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/tags>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/threshold>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/triggers_alerts>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/validates_actions>,
        <https://ontologies.corestory.ai/sao/shapes/AlertRule/validates_attributes> ;
    sh:targetClass sao:AlertRule .

saosh:AlertShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Alert/acknowledged_at>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/description>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/escalates_to_incident>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/id>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/name>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/resolved_at>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/severity>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/triggered_at>,
        <https://ontologies.corestory.ai/sao/shapes/Alert/triggered_by_rule> ;
    sh:targetClass sao:Alert .

saosh:HealthCheckShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/description>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/endpoint>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/failure_threshold>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/id>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/interval_seconds>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/name>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/success_threshold>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/tags>,
        <https://ontologies.corestory.ai/sao/shapes/HealthCheck/timeout_seconds> ;
    sh:targetClass sao:HealthCheck .

saosh:IncidentShape a sh:NodeShape ;
