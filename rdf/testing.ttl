sao:TestAssertion a rdfs:Class ;
    rdfs:label "TestAssertion" ;
    rdfs:comment "An individual assertion within a test case" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:TestCase a rdfs:Class ;
    rdfs:label "TestCase" ;
    rdfs:comment "A single test case that validates specific behavior" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:TestCoverage a rdfs:Class ;
    rdfs:label "TestCoverage" ;
    rdfs:comment "Code coverage metrics for a component or module" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:TestSuite a rdfs:Class ;
    rdfs:label "TestSuite" ;
    rdfs:comment "A collection of related test cases" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:TestCaseStatus a rdfs:Datatype ;
    rdfs:label "TestCaseStatus" ;
    rdfs:comment "Execution status of a test case" ;
