<https://ontologies.corestory.ai/sao/shapes/UIComponent/component_type/values/cell/8> rdf:first "higher_order" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/UIComponent/component_type/values/cell/9> .

<https://ontologies.corestory.ai/sao/shapes/UIComponent/component_type/values/cell/9> rdf:first "provider" ;
