spec:tool_version a rdf:Property ;
    rdfs:label "tool_version" ;
    rdfs:comment "[SpecActivity] Version of the tool used, if applicable." ;
    rdfs:domain spec:SpecActivity ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:string .

spec:uri a rdf:Property ;
    rdfs:label "uri" ;
    schema1:domainIncludes spec:SpecAgent,
        spec:SpecificationArtifact ;
    rdfs:comment "[SpecAgent] External identity or tool documentation URI.",
        "[SpecificationArtifact] Location of this representation." ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:anyURI .

spec:use_cases a rdf:Property ;
    rdfs:label "use_cases" ;
    schema1:domainIncludes spec:Specification,
        spec:SpecificationGraph ;
    rdfs:comment "[SpecificationGraph] Inline records of UseCase items; relationships between records use their identifiers.",
        "[Specification] User or stakeholder goals and their scenarios." ;
