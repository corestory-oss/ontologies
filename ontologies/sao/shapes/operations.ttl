saosh:ReleaseShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Release/changelog>,
        <https://ontologies.corestory.ai/sao/shapes/Release/deployed_in_deployments_as_release>,
        <https://ontologies.corestory.ai/sao/shapes/Release/description>,
        <https://ontologies.corestory.ai/sao/shapes/Release/effective_from>,
        <https://ontologies.corestory.ai/sao/shapes/Release/effective_to>,
        <https://ontologies.corestory.ai/sao/shapes/Release/has_artifacts>,
        <https://ontologies.corestory.ai/sao/shapes/Release/id>,
        <https://ontologies.corestory.ai/sao/shapes/Release/is_current>,
        <https://ontologies.corestory.ai/sao/shapes/Release/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Release/name>,
        <https://ontologies.corestory.ai/sao/shapes/Release/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Release/version> ;
    sh:targetClass sao:Release .

<https://ontologies.corestory.ai/sao/shapes/Configuration/config_type> a sh:PropertyShape ;
    sh:description "Kind of configuration." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:config_type .

<https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values> rdf:first "environment_variable" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/1> rdf:first "config_file" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/2> rdf:first "secret" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/3> rdf:first "feature_flag" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Configuration/config_type/values/cell/4> rdf:first "remote_config" ;
    rdf:rest () .

