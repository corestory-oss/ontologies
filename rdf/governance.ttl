sao:ComplianceRequirement a rdfs:Class ;
    rdfs:label "ComplianceRequirement" ;
    rdfs:comment "A regulatory or policy obligation" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Documents requirements from compliance frameworks that the system must satisfy." .

sao:Control a rdfs:Class ;
    rdfs:label "Control" ;
    rdfs:comment "A measure implementing a compliance requirement" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Specific security or compliance controls implemented to satisfy requirements." .

sao:Evidence a rdfs:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "Proof that a control is operating effectively" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Demonstrates to auditors that controls are implemented and effective." .

sao:RiskAssessment a rdfs:Class ;
    rdfs:label "RiskAssessment" ;
    rdfs:comment "An evaluation of threats and vulnerabilities" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Identify, analyze, and prioritize risks to the system." .

