<https://ontologies.corestory.ai/sao/shapes/UIComponent/component_type/values> rdf:first "page" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/UIComponent/component_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/UIComponent/component_type/values/cell/1> rdf:first "layout" ;
