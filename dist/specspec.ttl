    rdfs:isDefinedBy spec: ;
    rdfs:range spec:Requirement .

spec:priority a rdf:Property ;
    rdfs:label "priority" ;
    rdfs:comment "[Requirement] Priority expressed using the authoring team’s vocabulary." ;
    rdfs:domain spec:Requirement ;
    rdfs:isDefinedBy spec: ;
