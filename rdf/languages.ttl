sao:ProgrammingLanguage a rdfs:Class ;
    rdfs:label "ProgrammingLanguage" ;
    rdfs:comment "A programming language with its paradigms, type system, and runtime characteristics" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Enables structured cross-language analysis. Query \"show me all Rust modules\" without resorting to string matching on format or language fields." .

sao:has_default_error_model a rdf:Property ;
    rdfs:label "has_default_error_model" ;
    rdfs:comment "The default error handling model for this language.",
        "[ProgrammingLanguage] The default error handling model for this language." ;
    rdfs:domain sao:ProgrammingLanguage ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:ErrorModel .

sao:has_default_memory_model a rdf:Property ;
    rdfs:label "has_default_memory_model" ;
    rdfs:comment "The default memory management model for this language.",
        "[ProgrammingLanguage] The default memory management model for this language." ;
    rdfs:domain sao:ProgrammingLanguage ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:MemoryModel .

sao:has_gc a rdf:Property ;
    rdfs:label "has_gc" ;
