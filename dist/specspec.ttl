    rdfs:domain spec:RequirementReplacement ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:Requirement .

spec:replacements a rdf:Property ;
    rdfs:label "replacements" ;
    rdfs:comment "[ChangeProposal] Explicit before/after requirement pairs." ;
    rdfs:domain spec:ChangeProposal ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:RequirementReplacement .

spec:represents a rdf:Property ;
    rdfs:label "represents" ;
    schema1:domainIncludes spec:ArtifactFragment,
        spec:SpecificationArtifact ;
    rdfs:comment "[ArtifactFragment] Knowledge items represented by the fragment; one fragment may describe many items.",
        "[SpecificationArtifact] Knowledge items represented by this artifact." ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:SpecElement .

spec:requirement_kind a rdf:Property ;
    rdfs:label "requirement_kind" ;
    rdfs:comment "[Requirement] Broad category of obligation." ;
    rdfs:domain spec:Requirement ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:RequirementKind .

spec:requirement_replacements a rdf:Property ;
    rdfs:label "requirement_replacements" ;
    rdfs:comment "[SpecificationGraph] Inline records of RequirementReplacement items; relationships between records use their identifiers." ;
    rdfs:domain spec:SpecificationGraph ;
