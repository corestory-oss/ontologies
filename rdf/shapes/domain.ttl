saosh:ResourceTypeShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/ResourceType/classifies_resources>,
        <https://ontologies.corestory.ai/sao/shapes/ResourceType/description>,
