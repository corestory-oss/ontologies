saosh:DomainRelationshipShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/cardinality>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/description>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/foreign_key_field>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/has_source_entity>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/has_target_entity>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/id>,
