@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix saosh: <https://ontologies.corestory.ai/sao/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

saosh:AggregateShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Aggregate/aggregate_documented_by_artifacts>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/aggregates_entities>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/contained_in_bounded_context>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/description>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/enforced_by_invariant_rules>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/has_root_entity>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/has_value_objects>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/id>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/name>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/persisted_in_stores>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/produces_domain_events>,
        <https://ontologies.corestory.ai/sao/shapes/Aggregate/tags> ;
    sh:targetClass sao:Aggregate .

saosh:AttributeShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Attribute/category>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/classification>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/data_type>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/default_value>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/description>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/id>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/is_identifier>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/is_indexed>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/mapped_from_element>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/name>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Attribute/validated_by_rules> ;
    sh:targetClass sao:Attribute .

saosh:DomainEntityShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/DomainEntity/aggregated_by>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/attributes>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/audit_log>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/description>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/entity_documented_by_artifacts>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/exposes_as_resource>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/governed_by_lifecycle>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/governed_by_rules>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/has_incoming_relationships>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/has_outgoing_relationships>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/id>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/in_state>,
        <https://ontologies.corestory.ai/sao/shapes/DomainEntity/is_root_of_aggregate>,
