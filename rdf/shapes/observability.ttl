saosh:SpanShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Span/attributes>,
        <https://ontologies.corestory.ai/sao/shapes/Span/belongs_to_trace>,
        <https://ontologies.corestory.ai/sao/shapes/Span/child_of_span>,
        <https://ontologies.corestory.ai/sao/shapes/Span/description>,
        <https://ontologies.corestory.ai/sao/shapes/Span/end_time>,
        <https://ontologies.corestory.ai/sao/shapes/Span/id>,
        <https://ontologies.corestory.ai/sao/shapes/Span/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Span/name>,
        <https://ontologies.corestory.ai/sao/shapes/Span/operation_name>,
        <https://ontologies.corestory.ai/sao/shapes/Span/parent_of_spans>,
        <https://ontologies.corestory.ai/sao/shapes/Span/root_of_trace>,
        <https://ontologies.corestory.ai/sao/shapes/Span/span_id>,
        <https://ontologies.corestory.ai/sao/shapes/Span/start_time>,
        <https://ontologies.corestory.ai/sao/shapes/Span/status>,
        <https://ontologies.corestory.ai/sao/shapes/Span/tags> ;
    sh:targetClass sao:Span .

saosh:TraceShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Trace/contains_spans>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/description>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/id>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/name>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/starts_with_span>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Trace/trace_id> ;
    sh:targetClass sao:Trace .

<https://ontologies.corestory.ai/sao/shapes/Alert/acknowledged_at> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "When alert was acknowledged." ;
    sh:maxCount 1 ;
    sh:path sao:acknowledged_at .

<https://ontologies.corestory.ai/sao/shapes/Alert/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Alert/escalates_to_incident> a sh:PropertyShape ;
    sh:class sao:Incident ;
    sh:description "`Incident` if escalated." ;
    sh:path sao:escalates_to_incident .

<https://ontologies.corestory.ai/sao/shapes/Alert/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Alert/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Alert/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Alert/resolved_at> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "When issue was resolved." ;
    sh:maxCount 1 ;
    sh:path sao:resolved_at .

<https://ontologies.corestory.ai/sao/shapes/Alert/severity> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Alert severity (critical, warning, info)." ;
    sh:maxCount 1 ;
    sh:path sao:severity .

<https://ontologies.corestory.ai/sao/shapes/Alert/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Alert/triggered_at> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "When alert was triggered." ;
    sh:maxCount 1 ;
    sh:path sao:triggered_at .

<https://ontologies.corestory.ai/sao/shapes/Alert/triggered_by_rule> a sh:PropertyShape ;
    sh:class sao:AlertRule ;
    sh:description "`AlertRule` that triggered this alert." ;
    sh:maxCount 1 ;
    sh:path sao:triggered_by_rule .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/action> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Action when rule fires." ;
    sh:maxCount 1 ;
    sh:path sao:action .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/category> a sh:PropertyShape ;
    sh:description "Kind of rule." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values> ;
    sh:maxCount 1 ;
    sh:path sao:category .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values> rdf:first "validation" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/1> rdf:first "business" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/2> rdf:first "derivation" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/3> rdf:first "constraint" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/category/values/cell/4> rdf:first "trigger" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/condition> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Alert condition expression (e.g., \"error_rate > 5%\")." ;
    sh:maxCount 1 ;
    sh:path sao:condition .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/duration_seconds> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Duration before alerting (avoid flapping)." ;
    sh:maxCount 1 ;
    sh:path sao:duration_seconds .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/enforces_aggregate_invariants> a sh:PropertyShape ;
    sh:class sao:Aggregate ;
    sh:description "Back-reference to `Aggregate` entities whose invariants this rule enforces." ;
    sh:path sao:enforces_aggregate_invariants .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/governs_domain_entities> a sh:PropertyShape ;
    sh:class sao:DomainEntity ;
    sh:description "Back-reference to `DomainEntity` entities governed by this rule." ;
    sh:path sao:governs_domain_entities .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/guards_transitions> a sh:PropertyShape ;
    sh:class sao:Transition ;
    sh:description "Back-reference to `Transition` entities guarded by this rule." ;
    sh:path sao:guards_transitions .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/is_active> a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:description "Whether rule is currently active." ;
    sh:maxCount 1 ;
    sh:path sao:is_active .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/monitors_metrics> a sh:PropertyShape ;
    sh:class sao:Metric ;
    sh:description "`Metric` entities being monitored." ;
    sh:path sao:monitors_metrics .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/notification_channels> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Where to send alerts (email, Slack, PagerDuty)." ;
    sh:path sao:notification_channels .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/priority> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Evaluation priority." ;
    sh:maxCount 1 ;
    sh:path sao:priority .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/threshold> a sh:PropertyShape ;
    sh:datatype xsd:float ;
    sh:description "Threshold value." ;
    sh:maxCount 1 ;
    sh:path sao:threshold .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/triggers_alerts> a sh:PropertyShape ;
    sh:class sao:Alert ;
    sh:description "`Alert` entities triggered." ;
    sh:path sao:triggers_alerts .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/validates_actions> a sh:PropertyShape ;
    sh:class sao:Action ;
    sh:description "Back-reference to `Action` entities validated by this rule." ;
    sh:path sao:validates_actions .

<https://ontologies.corestory.ai/sao/shapes/AlertRule/validates_attributes> a sh:PropertyShape ;
    sh:class sao:Attribute ;
    sh:description "Back-reference to `Attribute` entities validated by this rule." ;
    sh:path sao:validates_attributes .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type> a sh:PropertyShape ;
    sh:description "Kind of health check." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:check_type .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values> rdf:first "liveness" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values/cell/1> rdf:first "readiness" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values/cell/2> rdf:first "dependency" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/check_type/values/cell/3> rdf:first "startup" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/endpoint> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Health check endpoint URL." ;
    sh:maxCount 1 ;
    sh:path sao:endpoint .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/failure_threshold> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Failures before marking unhealthy." ;
    sh:maxCount 1 ;
    sh:path sao:failure_threshold .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/interval_seconds> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Check frequency." ;
    sh:maxCount 1 ;
    sh:path sao:interval_seconds .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/success_threshold> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Successes before marking healthy." ;
    sh:maxCount 1 ;
    sh:path sao:success_threshold .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/HealthCheck/timeout_seconds> a sh:PropertyShape ;
    sh:datatype xsd:integer ;
    sh:description "Check timeout." ;
    sh:maxCount 1 ;
    sh:path sao:timeout_seconds .

<https://ontologies.corestory.ai/sao/shapes/Incident/affects_services> a sh:PropertyShape ;
    sh:class sao:Service ;
    sh:description "`Service` entities impacted." ;
    sh:path sao:affects_services .

<https://ontologies.corestory.ai/sao/shapes/Incident/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Incident/escalated_from_alerts> a sh:PropertyShape ;
    sh:class sao:Alert ;
    sh:description "`Alert` entities that led to incident." ;
    sh:path sao:escalated_from_alerts .

<https://ontologies.corestory.ai/sao/shapes/Incident/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Incident/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Incident/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Incident/postmortem_url> a sh:PropertyShape ;
    sh:datatype xsd:anyURI ;
    sh:description "Link to incident postmortem." ;
    sh:maxCount 1 ;
    sh:path sao:postmortem_url .

<https://ontologies.corestory.ai/sao/shapes/Incident/resolved_at> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Resolution time." ;
    sh:maxCount 1 ;
    sh:path sao:resolved_at .

<https://ontologies.corestory.ai/sao/shapes/Incident/root_cause> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Root cause analysis." ;
    sh:maxCount 1 ;
    sh:path sao:root_cause .

<https://ontologies.corestory.ai/sao/shapes/Incident/severity> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Incident severity (P1-P5 or SEV1-SEV5)." ;
    sh:maxCount 1 ;
    sh:path sao:severity .

<https://ontologies.corestory.ai/sao/shapes/Incident/started_at> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Incident start time." ;
    sh:maxCount 1 ;
    sh:path sao:started_at .

<https://ontologies.corestory.ai/sao/shapes/Incident/status> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Current status (investigating, identified, monitoring, resolved)." ;
