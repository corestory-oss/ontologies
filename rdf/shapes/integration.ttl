    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/14> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/14> rdf:first "shared_memory" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/2> rdf:first "websocket" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/3> rdf:first "grpc" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/4> rdf:first "amqp" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/5> rdf:first "mqtt" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/6> rdf:first "kafka" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/7> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/7> rdf:first "sftp" ;
