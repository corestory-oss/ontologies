@prefix export: <https://ontologies.corestory.ai/sao/export/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sao:CallableUnit a rdfs:Class ;
    rdfs:label "CallableUnit" ;
    rdfs:comment "A named, invocable unit of code that performs a specific task. Maps to: Method (OOP), Function (procedural/functional), Paragraph (COBOL), Procedure (SQL), Subroutine (Fortran), Lambda (functional)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:DataElement a rdfs:Class ;
    rdfs:label "DataElement" ;
    rdfs:comment "An individual data field or variable. Maps to: Field (OOP), Variable (procedural), Column (database), Data item (COBOL), Property (C#), Attribute (Python)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:DataStructure a rdfs:Class ;
    rdfs:label "DataStructure" ;
    rdfs:comment "A composite data type grouping related data elements. Maps to: Struct (C), Record (Pascal/COBOL), Class data (OOP), Type (Haskell), Dictionary (Python), Hash (Ruby)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:EncapsulationUnit a rdfs:Class ;
    rdfs:label "EncapsulationUnit" ;
    rdfs:comment "A logical boundary that groups related code and data. Maps to: Class (OOP), Program (COBOL), Module (functional), Package (Java), Namespace (C#), Record module (ML)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:Parameter a rdfs:Class ;
    rdfs:label "Parameter" ;
    rdfs:comment "An input/output parameter for a callable unit." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:DataElement .

sao:accesses_data_elements a rdf:Property ;
    rdfs:label "accesses_data_elements" ;
    rdfs:comment "Data elements accessed (read).",
        "[CallableUnit] Data elements accessed (read)." ;
    rdfs:domain sao:CallableUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataElement .

sao:affected_by_directives a rdf:Property ;
    rdfs:label "affected_by_directives" ;
    rdfs:comment "PreprocessorDirective[] affecting this unit.",
        "[EncapsulationUnit] PreprocessorDirective[] affecting this unit." ;
    rdfs:domain sao:EncapsulationUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:PreprocessorDirective .

sao:alignment a rdf:Property ;
    rdfs:label "alignment" ;
    rdfs:comment "Memory alignment in bytes.",
        "[DataStructure] Memory alignment in bytes." ;
    rdfs:domain sao:DataStructure ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:integer .

sao:callable_affected_by_directives a rdf:Property ;
    rdfs:label "callable_affected_by_directives" ;
    rdfs:comment "PreprocessorDirective[] affecting this callable.",
        "[CallableUnit] PreprocessorDirective[] affecting this callable." ;
    rdfs:domain sao:CallableUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:PreprocessorDirective .

sao:callable_category a rdf:Property ;
    rdfs:label "callable_category" ;
    rdfs:comment "[CallableUnit] `normal`, `operator`, or `main_entry`.",
        "`normal`, `operator`, or `main_entry`." ;
    rdfs:domain sao:CallableUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:CallableCategory .

sao:callable_type a rdf:Property ;
    rdfs:label "callable_type" ;
    rdfs:comment "**Required.** The paradigm-specific type (see CallableType enum).",
        "[CallableUnit] **Required.** The paradigm-specific type (see CallableType enum)." ;
    rdfs:domain sao:CallableUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:CallableType .

sao:calling_convention a rdf:Property ;
    rdfs:label "calling_convention" ;
    rdfs:comment "ABI calling convention.",
        "[CallableUnit] ABI calling convention." ;
    rdfs:domain sao:CallableUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:complexity_score a rdf:Property ;
    rdfs:label "complexity_score" ;
    rdfs:comment "Cyclomatic complexity or similar metric",
        "[CallableUnit] Cyclomatic complexity or similar metric" ;
    rdfs:domain sao:CallableUnit ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:integer .

