@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix saosh: <https://ontologies.corestory.ai/sao/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

saosh:AnnotationShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/annotation_syntax>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/description>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/id>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/name>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/parameters>,
        <https://ontologies.corestory.ai/sao/shapes/Annotation/tags> ;
    sh:targetClass sao:Annotation .

saosh:CodeBlockShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/CodeBlock/block_type>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/contained_in_callable>,
