specsh:IgnoredType rdf:first rdf:type ;
    rdf:rest () .

specsh:LifecycleStatusValues rdf:first "draft" ;
    rdf:rest ( "proposed" "accepted" "superseded" "retired" ) .

specsh:OriginModeValues rdf:first "observed" ;
    rdf:rest ( "inferred" "supplied" ) .

specsh:RequirementKindValues rdf:first "functional" ;
    rdf:rest ( "quality" "constraint" "compliance" ) .

specsh:ReviewStatusValues rdf:first "unreviewed" ;
    rdf:rest ( "needs_confirmation" "accepted" "rejected" "superseded" ) .

specsh:VerificationOutcomeValues rdf:first "passed" ;
    rdf:rest ( "failed" "inconclusive" "not_run" ) .

