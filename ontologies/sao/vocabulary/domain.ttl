@prefix export: <https://ontologies.corestory.ai/sao/export/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sao:Aggregate a rdfs:Class ;
    rdfs:label "Aggregate" ;
    rdfs:comment "A cluster of domain entities treated as a single transactional unit. Corresponds to DDD aggregate concept." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Enforces consistency boundaries and transactional integrity within the domain model." .

sao:Attribute a rdfs:Class ;
    rdfs:label "Attribute" ;
    rdfs:comment "A named property of an entity or value object" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Defines the data fields and their characteristics within domain objects." .

sao:DomainEntity a rdfs:Class ;
    rdfs:label "DomainEntity" ;
    rdfs:comment "A uniquely identifiable object within the domain" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:Auditable,
        sao:NamedEntity ;
    skos:note "Represents business objects with distinct identity that persists over time." .

sao:DomainRelationship a rdfs:Class ;
    rdfs:label "DomainRelationship" ;
    rdfs:comment "A named, typed relationship between two domain entities (e.g., Order has many OrderLines, User belongs to Organization)" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Explicitly captures how domain entities relate to each other, including cardinality, navigability, and composition semantics." .

sao:Lifecycle a rdfs:Class ;
    rdfs:label "Lifecycle" ;
    rdfs:comment "The complete set of states and transitions for an entity type" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Defines the full state machine governing entity lifecycle." .

sao:Resource a rdfs:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "A domain entity or value object exposed for external interaction" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents the external API representation of domain objects." .

sao:ResourceType a rdfs:Class ;
    rdfs:label "ResourceType" ;
    rdfs:comment "A classification of resources sharing common structure and behavior" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Groups similar resources and defines their schema." .

sao:State a rdfs:Class ;
    rdfs:label "State" ;
    rdfs:comment "A discrete condition in an entity's lifecycle" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents a specific stage in an entity's lifecycle with allowed actions." .

sao:Transition a rdfs:Class ;
    rdfs:label "Transition" ;
    rdfs:comment "A valid movement between states" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Defines allowed state changes and their conditions." .

sao:ValueObject a rdfs:Class ;
    rdfs:label "ValueObject" ;
    rdfs:comment "An immutable domain object defined by its attributes" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents descriptive aspects of the domain with no conceptual identity." .

sao:AttributeCategory a rdfs:Datatype ;
    rdfs:label "AttributeCategory" ;
    rdfs:comment "Categories of entity attributes" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/AttributeCategory/computed>,
        <https://ontologies.corestory.ai/sao/export/values/AttributeCategory/derived>,
        <https://ontologies.corestory.ai/sao/export/values/AttributeCategory/optional>,
        <https://ontologies.corestory.ai/sao/export/values/AttributeCategory/required>,
        <https://ontologies.corestory.ai/sao/export/values/AttributeCategory/transient> .

sao:affected_in_audit a rdf:Property ;
    rdfs:label "affected_in_audit" ;
    rdfs:comment "Audit trail entries.",
        "[Resource] Audit trail entries." ;
    rdfs:domain sao:Resource ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:AuditEntry .

sao:aggregate_documented_by_artifacts a rdf:Property ;
    rdfs:label "aggregate_documented_by_artifacts" ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:KnowledgeArtifact .

sao:aggregated_by a rdf:Property ;
    rdfs:label "aggregated_by" ;
    rdfs:comment "Parent `Aggregate`.",
        "[DomainEntity] Parent `Aggregate`." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Aggregate .

sao:aggregates_entities a rdf:Property ;
    rdfs:label "aggregates_entities" ;
    rdfs:comment "[Aggregate] `DomainEntity` instances within this aggregate.",
        "`DomainEntity` instances within this aggregate." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:allows_actions_in_state a rdf:Property ;
    rdfs:label "allows_actions_in_state" ;
    rdfs:comment "[State] `Action` entities allowed in this state.",
        "`Action` entities allowed in this state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Action .

sao:belongs_to_aggregate a rdf:Property ;
    rdfs:label "belongs_to_aggregate" ;
    rdfs:domain sao:ValueObject ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Aggregate .

sao:cardinality a rdf:Property ;
    rdfs:label "cardinality" ;
    rdfs:comment "The multiplicity of the relationship.",
        "[DomainRelationship] The multiplicity of the relationship." ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Cardinality .

sao:classified_as_type a rdf:Property ;
    rdfs:label "classified_as_type" ;
    rdfs:comment "[Resource] `ResourceType` classification.",
        "`ResourceType` classification." ;
    rdfs:domain sao:Resource ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:ResourceType .

sao:classifies_resources a rdf:Property ;
    rdfs:label "classifies_resources" ;
    rdfs:comment "[ResourceType] `Resource` instances of this type.",
        "`Resource` instances of this type." ;
    rdfs:domain sao:ResourceType ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Resource .

sao:contained_in_bounded_context a rdf:Property ;
    rdfs:label "contained_in_bounded_context" ;
    rdfs:comment "Parent `BoundedContext`.",
        "[Aggregate] Parent `BoundedContext`." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:BoundedContext .

sao:current_for_entities a rdf:Property ;
    rdfs:label "current_for_entities" ;
    rdfs:comment "[State] `DomainEntity` instances currently in this state.",
        "`DomainEntity` instances currently in this state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:enforced_by_invariant_rules a rdf:Property ;
    rdfs:label "enforced_by_invariant_rules" ;
    rdfs:comment "[Aggregate] `Rule` entities that enforce aggregate invariants.",
        "`Rule` entities that enforce aggregate invariants." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Rule .

sao:entity_documented_by_artifacts a rdf:Property ;
    rdfs:label "entity_documented_by_artifacts" ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:KnowledgeArtifact .

sao:executes_actions_on_transition a rdf:Property ;
    rdfs:label "executes_actions_on_transition" ;
    rdfs:comment "[Transition] `Action` entities executed during transition.",
        "`Action` entities executed during transition." ;
    rdfs:domain sao:Transition ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Action .

sao:exposes_as_resource a rdf:Property ;
    rdfs:label "exposes_as_resource" ;
    rdfs:comment "[DomainEntity] `Resource` entities that expose this entity externally.",
        "`Resource` entities that expose this entity externally." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Resource .

sao:foreign_key_field a rdf:Property ;
    rdfs:label "foreign_key_field" ;
    rdfs:comment "The field implementing this relationship in the data layer",
        "[DomainRelationship] The field implementing this relationship in the data layer" ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:governed_by_lifecycle a rdf:Property ;
    rdfs:label "governed_by_lifecycle" ;
    rdfs:comment "[DomainEntity] `Lifecycle` defining valid states and transitions.",
        "`Lifecycle` defining valid states and transitions." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Lifecycle .

sao:governed_by_permissions a rdf:Property ;
    rdfs:label "governed_by_permissions" ;
    rdfs:comment "[ResourceType] `Permission` entities that apply.",
        "`Permission` entities that apply." ;
    rdfs:domain sao:ResourceType ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Permission .

sao:governed_by_rules a rdf:Property ;
    rdfs:label "governed_by_rules" ;
    rdfs:comment "[DomainEntity] `Rule` entities governing this entity.",
        "`Rule` entities governing this entity." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Rule .

sao:governs_entities a rdf:Property ;
    rdfs:label "governs_entities" ;
    rdfs:comment "[Lifecycle] `DomainEntity` instances following this lifecycle.",
        "`DomainEntity` instances following this lifecycle." ;
    rdfs:domain sao:Lifecycle ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:guarded_by_rules a rdf:Property ;
    rdfs:label "guarded_by_rules" ;
    rdfs:comment "[Transition] `Rule` entities that must be satisfied.",
        "`Rule` entities that must be satisfied." ;
    rdfs:domain sao:Transition ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Rule .

sao:has_attributes a rdf:Property ;
    rdfs:label "has_attributes" ;
    rdfs:comment "List of `Attribute` entities defining the value object.",
        "[ValueObject] List of `Attribute` entities defining the value object." ;
    rdfs:domain sao:ValueObject ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Attribute .

sao:has_incoming_relationships a rdf:Property ;
    rdfs:label "has_incoming_relationships" ;
    rdfs:comment "[DomainEntity] `DomainRelationship` entities where this entity is the target.",
        "`DomainRelationship` entities where this entity is the target." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainRelationship .

sao:has_outgoing_relationships a rdf:Property ;
    rdfs:label "has_outgoing_relationships" ;
    rdfs:comment "[DomainEntity] `DomainRelationship` entities where this entity is the source.",
        "`DomainRelationship` entities where this entity is the source." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainRelationship .

sao:has_root_entity a rdf:Property ;
    rdfs:label "has_root_entity" ;
    rdfs:comment "The root `DomainEntity` (required, single).",
        "[Aggregate] The root `DomainEntity` (required, single)." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:has_source_entity a rdf:Property ;
    rdfs:label "has_source_entity" ;
    rdfs:comment "The `DomainEntity` that owns or originates the relationship (inverse: `has_outgoing_relationships` on DomainEntity).",
        "[DomainRelationship] The `DomainEntity` that owns or originates the relationship (inverse: `has_outgoing_relationships` on DomainEntity)." ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:has_states a rdf:Property ;
    rdfs:label "has_states" ;
    rdfs:comment "List of all `State` entities in the lifecycle.",
        "[Lifecycle] List of all `State` entities in the lifecycle." ;
    rdfs:domain sao:Lifecycle ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:State .

sao:has_target_entity a rdf:Property ;
    rdfs:label "has_target_entity" ;
    rdfs:comment "The `DomainEntity` that is referenced by the relationship (inverse: `has_incoming_relationships` on DomainEntity).",
        "[DomainRelationship] The `DomainEntity` that is referenced by the relationship (inverse: `has_incoming_relationships` on DomainEntity)." ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:has_transitions a rdf:Property ;
    rdfs:label "has_transitions" ;
    rdfs:comment "List of all `Transition` entities.",
        "[Lifecycle] List of all `Transition` entities." ;
    rdfs:domain sao:Lifecycle ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Transition .

sao:has_value_objects a rdf:Property ;
    rdfs:label "has_value_objects" ;
    rdfs:comment "List of value objects within the aggregate.",
        "[Aggregate] List of value objects within the aggregate." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:ValueObject .

sao:in_state a rdf:Property ;
    rdfs:label "in_state" ;
    rdfs:comment "Current `State` in the lifecycle.",
        "[DomainEntity] Current `State` in the lifecycle." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:State .

sao:initial_for_lifecycle a rdf:Property ;
    rdfs:label "initial_for_lifecycle" ;
    rdfs:comment "Back-reference to the `Lifecycle` for which this is the initial state.",
        "[State] Back-reference to the `Lifecycle` for which this is the initial state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Lifecycle .

sao:is_bidirectional a rdf:Property ;
    rdfs:label "is_bidirectional" ;
    rdfs:comment "Whether the relationship can be navigated in both directions.",
        "[DomainRelationship] Whether the relationship can be navigated in both directions." ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_composition a rdf:Property ;
    rdfs:label "is_composition" ;
    rdfs:comment "Whether the target's lifecycle depends on the source (UML composition)",
        "[DomainRelationship] Whether the target's lifecycle depends on the source (UML composition)" ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_identifier a rdf:Property ;
    rdfs:label "is_identifier" ;
    rdfs:comment "Whether this is an identifier attribute.",
        "[Attribute] Whether this is an identifier attribute." ;
    rdfs:domain sao:Attribute ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_indexed a rdf:Property ;
    rdfs:label "is_indexed" ;
    rdfs:comment "Whether this attribute should be indexed.",
        "[Attribute] Whether this attribute should be indexed." ;
    rdfs:domain sao:Attribute ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_initial a rdf:Property ;
    rdfs:label "is_initial" ;
    rdfs:comment "Whether this is the initial state.",
        "[State] Whether this is the initial state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_navigable a rdf:Property ;
    rdfs:label "is_navigable" ;
    rdfs:comment "Whether the relationship can be traversed from source to target",
        "[DomainRelationship] Whether the relationship can be traversed from source to target" ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_root_of_aggregate a rdf:Property ;
    rdfs:label "is_root_of_aggregate" ;
    rdfs:comment "Aggregate for which this is the root entity.",
        "[DomainEntity] Aggregate for which this is the root entity." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Aggregate .

sao:is_terminal a rdf:Property ;
    rdfs:label "is_terminal" ;
    rdfs:comment "Whether this is a final/terminal state.",
        "[State] Whether this is a final/terminal state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:join_entity a rdf:Property ;
    rdfs:label "join_entity" ;
    rdfs:comment "For many-to-many, the name of the join table/entity",
        "[DomainRelationship] For many-to-many, the name of the join table/entity" ;
    rdfs:domain sao:DomainRelationship ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:mapped_from_element a rdf:Property ;
    rdfs:label "mapped_from_element" ;
    rdfs:comment "Back-reference to the `DataElement` that maps to this attribute.",
        "[Attribute] Back-reference to the `DataElement` that maps to this attribute." ;
    rdfs:domain sao:Attribute ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataElement .

sao:mapped_from_structure a rdf:Property ;
    rdfs:label "mapped_from_structure" ;
    rdfs:comment "Code structures.",
        "[DomainEntity] Code structures." ;
    rdfs:domain sao:DomainEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataStructure .

sao:mapped_from_structure_vo a rdf:Property ;
    rdfs:label "mapped_from_structure_vo" ;
    rdfs:comment "Back-reference to the `DataStructure` that maps to this value object.",
        "[ValueObject] Back-reference to the `DataStructure` that maps to this value object." ;
    rdfs:domain sao:ValueObject ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataStructure .

sao:persisted_in_stores a rdf:Property ;
    rdfs:label "persisted_in_stores" ;
    rdfs:comment "[Aggregate] `DataStore` entities where this aggregate is persisted.",
        "`DataStore` entities where this aggregate is persisted." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataStore .

sao:produces_domain_events a rdf:Property ;
    rdfs:label "produces_domain_events" ;
    rdfs:comment "[Aggregate] `DomainEvent` entities produced.",
        "`DomainEvent` entities produced." ;
    rdfs:domain sao:Aggregate ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEvent .

sao:represents_entity a rdf:Property ;
    rdfs:label "represents_entity" ;
    rdfs:comment "The `DomainEntity` this resource represents.",
        "[Resource] The `DomainEntity` this resource represents." ;
    rdfs:domain sao:Resource ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DomainEntity .

sao:source_of_transitions a rdf:Property ;
    rdfs:label "source_of_transitions" ;
    rdfs:comment "[State] `Transition` entities starting from this state.",
        "`Transition` entities starting from this state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Transition .

sao:starts_with_state a rdf:Property ;
    rdfs:label "starts_with_state" ;
    rdfs:comment "Initial `State`.",
        "[Lifecycle] Initial `State`." ;
    rdfs:domain sao:Lifecycle ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:State .

sao:structured_by_schema a rdf:Property ;
    rdfs:label "structured_by_schema" ;
    rdfs:comment "[ResourceType] `Schema` defining the structure.",
        "`Schema` defining the structure." ;
    rdfs:domain sao:ResourceType ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Schema .

sao:target_of_transitions a rdf:Property ;
    rdfs:label "target_of_transitions" ;
    rdfs:comment "[State] `Transition` entities ending in this state.",
        "`Transition` entities ending in this state." ;
    rdfs:domain sao:State ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Transition .

sao:targeted_by_actions a rdf:Property ;
    rdfs:label "targeted_by_actions" ;
    rdfs:comment "[Resource] `Action` entities that can target this resource.",
        "`Action` entities that can target this resource." ;
    rdfs:domain sao:Resource ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Action .

sao:transitions_from_state a rdf:Property ;
    rdfs:label "transitions_from_state" ;
    rdfs:comment "Source `State` (required).",
        "[Transition] Source `State` (required)." ;
    rdfs:domain sao:Transition ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:State .

sao:transitions_to_state a rdf:Property ;
    rdfs:label "transitions_to_state" ;
    rdfs:comment "Target `State` (required).",
        "[Transition] Target `State` (required)." ;
    rdfs:domain sao:Transition ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:State .

sao:triggered_by_events a rdf:Property ;
    rdfs:label "triggered_by_events" ;
    rdfs:comment "[Transition] `Event` entities that trigger this transition.",
        "`Event` entities that trigger this transition." ;
    rdfs:domain sao:Transition ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Event .

sao:validated_by_rules a rdf:Property ;
    rdfs:label "validated_by_rules" ;
    rdfs:comment "[Attribute] `Rule` entities that validate this attribute.",
        "`Rule` entities that validate this attribute." ;
    rdfs:domain sao:Attribute ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Rule .

sao:Cardinality a rdfs:Datatype ;
    rdfs:label "Cardinality" ;
    rdfs:comment "Relationship cardinality options" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/Cardinality/many_to_many>,
        <https://ontologies.corestory.ai/sao/export/values/Cardinality/many_to_one>,
        <https://ontologies.corestory.ai/sao/export/values/Cardinality/one_to_many>,
        <https://ontologies.corestory.ai/sao/export/values/Cardinality/one_to_one> .

<https://ontologies.corestory.ai/sao/export/values/AttributeCategory/computed> rdf:value "computed" ;
    rdfs:comment "Computed or calculated attribute." .

<https://ontologies.corestory.ai/sao/export/values/AttributeCategory/derived> rdf:value "derived" ;
    rdfs:comment "Derived from other attributes." .

<https://ontologies.corestory.ai/sao/export/values/AttributeCategory/optional> rdf:value "optional" ;
    rdfs:comment "Optional attribute that may be null." .

<https://ontologies.corestory.ai/sao/export/values/AttributeCategory/required> rdf:value "required" ;
    rdfs:comment "Required attribute that must have a value." .

<https://ontologies.corestory.ai/sao/export/values/AttributeCategory/transient> rdf:value "transient" ;
    rdfs:comment "Transient attribute not persisted." .

<https://ontologies.corestory.ai/sao/export/values/Cardinality/many_to_many> rdf:value "many_to_many" ;
    rdfs:comment "Many-to-many relationship." .

<https://ontologies.corestory.ai/sao/export/values/Cardinality/many_to_one> rdf:value "many_to_one" ;
    rdfs:comment "Many-to-one relationship." .

<https://ontologies.corestory.ai/sao/export/values/Cardinality/one_to_many> rdf:value "one_to_many" ;
    rdfs:comment "One-to-many relationship." .

<https://ontologies.corestory.ai/sao/export/values/Cardinality/one_to_one> rdf:value "one_to_one" ;
    rdfs:comment "One-to-one relationship." .

