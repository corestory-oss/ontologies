    sh:datatype xsd:boolean ;
    sh:description "Whether this is an identifier attribute." ;
    sh:maxCount 1 ;
    sh:path sao:is_identifier .

<https://ontologies.corestory.ai/sao/shapes/Attribute/is_indexed> a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:description "Whether this attribute should be indexed." ;
    sh:maxCount 1 ;
    sh:path sao:is_indexed .

<https://ontologies.corestory.ai/sao/shapes/Attribute/mapped_from_element> a sh:PropertyShape ;
    sh:class sao:DataElement ;
    sh:description "Back-reference to the `DataElement` that maps to this attribute." ;
    sh:path sao:mapped_from_element .

<https://ontologies.corestory.ai/sao/shapes/Attribute/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Attribute/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Attribute/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Attribute/validated_by_rules> a sh:PropertyShape ;
    sh:class sao:Rule ;
    sh:description "`Rule` entities that validate this attribute." ;
    sh:path sao:validated_by_rules .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/aggregated_by> a sh:PropertyShape ;
    sh:class sao:Aggregate ;
    sh:description "Parent `Aggregate`." ;
    sh:maxCount 1 ;
    sh:path sao:aggregated_by .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/attributes> a sh:PropertyShape ;
    sh:class sao:Attribute ;
    sh:description "List of `Attribute` entities." ;
    sh:path sao:attributes .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/audit_log> a sh:PropertyShape ;
    sh:class sao:AuditLog ;
    sh:maxCount 1 ;
    sh:path sao:audit_log .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications> a sh:PropertyShape ;
    sh:description "Data classification types applied." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values> ;
    sh:path sao:classifications .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values> rdf:first "public" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/1> rdf:first "internal" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/2> rdf:first "confidential" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/3> rdf:first "restricted" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/DomainEntity/classifications/values/cell/4> rdf:first "pii" ;
