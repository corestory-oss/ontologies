<https://ontologies.corestory.ai/sao/shapes/Adapter/component_documented_by_artifacts> a sh:PropertyShape ;
    sh:class sao:KnowledgeArtifact ;
    sh:path sao:component_documented_by_artifacts .

<https://ontologies.corestory.ai/sao/shapes/Adapter/component_serves_model> a sh:PropertyShape ;
    sh:class sao:MLModel ;
    sh:description "ML models served by this component." ;
    sh:path sao:component_serves_model .

<https://ontologies.corestory.ai/sao/shapes/Adapter/component_type> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Type of component, such as a class, service, or handler." ;
    sh:maxCount 1 ;
    sh:path sao:component_type .

<https://ontologies.corestory.ai/sao/shapes/Adapter/component_uses_concurrency_pattern> a sh:PropertyShape ;
    sh:class sao:ConcurrencyPattern ;
    sh:description "Concurrency patterns used by this component." ;
    sh:path sao:component_uses_concurrency_pattern .

<https://ontologies.corestory.ai/sao/shapes/Adapter/contained_in_module> a sh:PropertyShape ;
    sh:class sao:Module ;
    sh:description "The parent module." ;
    sh:maxCount 1 ;
    sh:path sao:contained_in_module .

<https://ontologies.corestory.ai/sao/shapes/Adapter/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Adapter/emits_events> a sh:PropertyShape ;
    sh:class sao:Event ;
    sh:description "Events produced by this component." ;
    sh:path sao:emits_events .

<https://ontologies.corestory.ai/sao/shapes/Adapter/emits_metric> a sh:PropertyShape ;
    sh:class sao:Metric ;
    sh:description "Named metric link." ;
    sh:path sao:emits_metric .

<https://ontologies.corestory.ai/sao/shapes/Adapter/emits_metrics> a sh:PropertyShape ;
    sh:class sao:Metric ;
    sh:description "Metrics emitted by this component." ;
    sh:path sao:emits_metrics .

<https://ontologies.corestory.ai/sao/shapes/Adapter/exposes_operations> a sh:PropertyShape ;
    sh:class sao:Operation ;
    sh:description "Operations that can be invoked on this component." ;
    sh:path sao:exposes_operations .

<https://ontologies.corestory.ai/sao/shapes/Adapter/generates_logs> a sh:PropertyShape ;
    sh:class sao:Log ;
    sh:description "Logs generated by this component." ;
    sh:path sao:generates_logs .

<https://ontologies.corestory.ai/sao/shapes/Adapter/has_coverage> a sh:PropertyShape ;
    sh:class sao:TestCoverage ;
    sh:description "Test coverage for this component." ;
    sh:maxCount 1 ;
    sh:path sao:has_coverage .

<https://ontologies.corestory.ai/sao/shapes/Adapter/has_dependencies> a sh:PropertyShape ;
    sh:class sao:Dependency ;
    sh:description "Component-level dependencies." ;
    sh:path sao:has_dependencies .

<https://ontologies.corestory.ai/sao/shapes/Adapter/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code> a sh:PropertyShape ;
    sh:description "Code implementations of this component." ;
    sh:or <https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternatives> ;
    sh:path sao:implemented_by_code .

<https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternative/0> sh:class sao:CodeContainer .

<https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternative/1> sh:class sao:EncapsulationUnit .

<https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternatives> rdf:first <https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternative/0> ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternatives/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternatives/cell/1> rdf:first <https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code/alternative/1> ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Adapter/language> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Implementation language (DEPRECATED -- use written_in_language on CodeContainer)" ;
    sh:maxCount 1 ;
    sh:path sao:language .

<https://ontologies.corestory.ai/sao/shapes/Adapter/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Adapter/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_location> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Path to the source code." ;
    sh:maxCount 1 ;
    sh:path sao:source_location .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol> a sh:PropertyShape ;
    sh:description "Protocol to translate from." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values> ;
    sh:maxCount 1 ;
    sh:path sao:source_protocol .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values> rdf:first "http" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/1> rdf:first "https" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/10> rdf:first "corba" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/11> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/11> rdf:first "dcom" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/12> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/12> rdf:first "rmi" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/13> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/13> rdf:first "named_pipe" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/14> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/14> rdf:first "shared_memory" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/2> rdf:first "websocket" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/3> rdf:first "grpc" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/4> rdf:first "amqp" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/5> rdf:first "mqtt" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/6> rdf:first "kafka" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/7> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/7> rdf:first "sftp" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/8> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/8> rdf:first "tcp" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/9> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/9> rdf:first "udp" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol/values/cell/10> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol> a sh:PropertyShape ;
