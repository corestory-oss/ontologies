@prefix export: <https://ontologies.corestory.ai/sao/export/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sao:Auditable a rdfs:Class ;
    rdfs:label "Auditable" ;
    rdfs:comment "Mixin for entities requiring audit trails" ;
    rdfs:isDefinedBy sao: .

sao:Metadata a rdfs:Class ;
    rdfs:label "Metadata" ;
    rdfs:comment "Common metadata for entities" ;
    rdfs:isDefinedBy sao: .

sao:NamedEntity a rdfs:Class ;
    rdfs:label "NamedEntity" ;
    rdfs:comment "Abstract base class for all named entities in the ontology" ;
    rdfs:isDefinedBy sao: .

sao:Versionable a rdfs:Class ;
    rdfs:label "Versionable" ;
    rdfs:comment "Mixin for entities that support versioning" ;
    rdfs:isDefinedBy sao: .

xsd:date a rdfs:Datatype .

xsd:decimal a rdfs:Datatype .

xsd:double a rdfs:Datatype .

xsd:time a rdfs:Datatype .

<http://www.w3.org/ns/shex#iri> a rdfs:Datatype .

<http://www.w3.org/ns/shex#nonLiteral> a rdfs:Datatype .

sao:DatabaseType a rdfs:Datatype ;
    rdfs:label "DatabaseType" ;
    rdfs:comment "Types of database management systems" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/DatabaseType/adabas>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/cassandra>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/db2>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/idms>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/ims_db>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/informix>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/mongodb>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/mysql>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/oracle>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/postgresql>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/sql_server>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/sqlite>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/sybase>,
        <https://ontologies.corestory.ai/sao/export/values/DatabaseType/teradata> .

sao:EqualitySemantics a rdfs:Datatype ;
    rdfs:label "EqualitySemantics" ;
    rdfs:comment "How equality is determined for value types" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/EqualitySemantics/by_identity>,
        <https://ontologies.corestory.ai/sao/export/values/EqualitySemantics/by_reference>,
        <https://ontologies.corestory.ai/sao/export/values/EqualitySemantics/by_value>,
        <https://ontologies.corestory.ai/sao/export/values/EqualitySemantics/custom> .

sao:LinkageType a rdfs:Datatype ;
    rdfs:label "LinkageType" ;
    rdfs:comment "Types of callable linkage" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/LinkageType/dynamic>,
        <https://ontologies.corestory.ai/sao/export/values/LinkageType/inline>,
        <https://ontologies.corestory.ai/sao/export/values/LinkageType/late_binding>,
        <https://ontologies.corestory.ai/sao/export/values/LinkageType/static> .

sao:MessageFormat a rdfs:Datatype ;
    rdfs:label "MessageFormat" ;
    rdfs:comment "Message serialization formats" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/MessageFormat/avro>,
        <https://ontologies.corestory.ai/sao/export/values/MessageFormat/custom_binary>,
        <https://ontologies.corestory.ai/sao/export/values/MessageFormat/json>,
        <https://ontologies.corestory.ai/sao/export/values/MessageFormat/msgpack>,
        <https://ontologies.corestory.ai/sao/export/values/MessageFormat/protobuf>,
        <https://ontologies.corestory.ai/sao/export/values/MessageFormat/thrift>,
        <https://ontologies.corestory.ai/sao/export/values/MessageFormat/xml> .

sao:SecurityType a rdfs:Datatype ;
    rdfs:label "SecurityType" ;
    rdfs:comment "Database security context types" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/SecurityType/definer>,
        <https://ontologies.corestory.ai/sao/export/values/SecurityType/invoker> .

sao:StructureLayout a rdfs:Datatype ;
    rdfs:label "StructureLayout" ;
    rdfs:comment "Memory layout strategies for structures" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf rdfs:Literal ;
    export:permissibleValue <https://ontologies.corestory.ai/sao/export/values/StructureLayout/auto>,
        <https://ontologies.corestory.ai/sao/export/values/StructureLayout/explicit>,
        <https://ontologies.corestory.ai/sao/export/values/StructureLayout/packed>,
        <https://ontologies.corestory.ai/sao/export/values/StructureLayout/sequential> .

sao:affects_behavior_of a rdf:Property ;
    rdfs:label "affects_behavior_of" ;
    rdfs:comment "Code elements whose behavior is altered by this annotation.",
        "[Annotation] Code elements whose behavior is altered by this annotation." ;
    rdfs:domain sao:Annotation ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:annotated_by a rdf:Property ;
    rdfs:label "annotated_by" ;
    schema:domainIncludes sao:CallableUnit,
        sao:DataElement,
        sao:DataStructure,
        sao:EncapsulationUnit ;
    rdfs:comment "Annotations applied to this code element.",
        "[CallableUnit] Annotations applied to this code element.",
        "[DataElement] Annotations applied to this code element.",
        "[DataStructure] Annotations applied to this code element.",
        "[EncapsulationUnit] Annotations applied to this code element." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Annotation .

sao:annotates_element a rdf:Property ;
    rdfs:label "annotates_element" ;
    rdfs:comment "Code elements bearing this annotation.",
        "[Annotation] Code elements bearing this annotation." ;
    rdfs:domain sao:Annotation ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:artifact_type a rdf:Property ;
    rdfs:label "artifact_type" ;
    schema:domainIncludes sao:BuildArtifact,
        sao:KnowledgeArtifact ;
    schema:rangeIncludes sao:ArtifactType,
        sao:KnowledgeArtifactType ;
    rdfs:comment "Kind of artifact.",
        "[BuildArtifact] Kind of artifact." ;
    rdfs:isDefinedBy sao: .

sao:artifact_uri a rdf:Property ;
    rdfs:label "artifact_uri" ;
    schema:domainIncludes sao:BuildArtifact,
        sao:DeploymentUnit,
        sao:Evidence ;
    rdfs:comment "Location of the deployment artifact.",
        "[BuildArtifact] Artifact location.",
        "[DeploymentUnit] Location of the deployment artifact.",
        "[Evidence] Location of evidence artifact." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:URI .

sao:attributes a rdf:Property ;
    rdfs:label "attributes" ;
    schema:domainIncludes sao:DomainEntity,
        sao:Span ;
    schema:rangeIncludes xsd:string,
        sao:Attribute ;
    rdfs:comment "List of `Attribute` entities.",
        "[DomainEntity] List of `Attribute` entities.",
        "[Span] Key-value pairs with additional context." ;
    rdfs:isDefinedBy sao: .

sao:audit_log a rdf:Property ;
    rdfs:label "audit_log" ;
    rdfs:domain sao:Auditable ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:AuditLog .

sao:base_url a rdf:Property ;
    rdfs:label "base_url" ;
    schema:domainIncludes sao:ArtifactRegistry,
        sao:ProgrammaticInterface ;
    rdfs:comment "Base URL for the API.",
        "[ArtifactRegistry] Registry base URL.",
        "[ProgrammaticInterface] Base URL for the API." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:URI .

sao:category a rdf:Property ;
    rdfs:label "category" ;
    schema:domainIncludes sao:Action,
        sao:Actor,
        sao:Attribute,
        sao:Event,
        sao:Feature,
        sao:Interface,
        sao:Rule ;
    schema:rangeIncludes sao:ActionCategory,
        sao:ActorCategory,
        sao:AttributeCategory,
        sao:EventCategory,
        sao:FeatureCategory,
        sao:InterfaceCategory,
        sao:RuleCategory ;
    rdfs:comment "Feature category: core, optional, experimental, or deprecated.",
        "[Action] `query` (read-only), `command` (state-changing), `mutation` (data modification).",
        "[Actor] Actor category (`human`, `system`).",
        "[Attribute] `required`, `optional`, `computed`, `derived`, `transient`.",
        "[Event] Kind of event.",
        "[Feature] Feature category: core, optional, experimental, or deprecated.",
        "[Interface] Interface category: user interface, programmatic interface, or event interface.",
        "[Rule] Kind of rule." ;
    rdfs:isDefinedBy sao: .

sao:checksum a rdf:Property ;
    rdfs:label "checksum" ;
    schema:domainIncludes sao:BuildArtifact,
        sao:CodeContainer,
        sao:DeploymentUnit ;
    rdfs:comment "Content hash for version tracking.",
        "[BuildArtifact] Integrity checksum.",
        "[CodeContainer] Content hash for version tracking.",
        "[DeploymentUnit] Artifact integrity checksum." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:classification a rdf:Property ;
    rdfs:label "classification" ;
    schema:domainIncludes sao:Attribute,
        sao:DataElement,
        sao:Dataset ;
    rdfs:comment "Data sensitivity (PII, PHI, PCI, etc.).",
        "[Attribute] Data classification (`public`, `internal`, `confidential`, `pii`, etc.).",
        "[DataElement] Data sensitivity (PII, PHI, PCI, etc.).",
        "[Dataset] Data classification." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataClassificationType .

sao:classifications a rdf:Property ;
    rdfs:label "classifications" ;
    schema:domainIncludes sao:DomainEntity,
        sao:Record ;
    rdfs:comment "Data classification types applied.",
        "[DomainEntity] Data classification types applied.",
        "[Record] Data sensitivity classifications." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataClassificationType .

sao:columns a rdf:Property ;
    rdfs:label "columns" ;
    schema:domainIncludes sao:DatabaseConstraint,
        sao:DatabaseIndex,
        sao:ScreenDefinition ;
    schema:rangeIncludes xsd:integer,
        xsd:string ;
    rdfs:comment "Number of screen columns.",
        "[DatabaseConstraint] Columns involved in the constraint.",
        "[DatabaseIndex] Columns included in the index.",
        "[ScreenDefinition] Number of screen columns." ;
    rdfs:isDefinedBy sao: .

sao:component_type a rdf:Property ;
    rdfs:label "component_type" ;
    schema:domainIncludes sao:Component,
        sao:UIComponent ;
    schema:rangeIncludes xsd:string,
        sao:UIComponentType ;
    rdfs:comment "Type of component, such as a class, service, or handler.",
        "[Component] Type of component, such as a class, service, or handler.",
        "[UIComponent] Kind of UI component." ;
    rdfs:isDefinedBy sao: .

sao:condition a rdf:Property ;
    rdfs:label "condition" ;
    schema:domainIncludes sao:AlertRule,
        sao:ControlFlow,
        sao:PipelineStage,
        sao:PreprocessorDirective,
        sao:Rule,
        sao:Step ;
    rdfs:comment "Condition expression.",
        "[AlertRule] Alert condition expression (e.g., \"error_rate > 5%\").",
        "[ControlFlow] Condition expression.",
        "[PipelineStage] Execution condition.",
        "[PreprocessorDirective] Conditional compilation expression",
        "[Rule] Rule condition expression.",
        "[Step] Condition for execution." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:constraint_type a rdf:Property ;
    rdfs:label "constraint_type" ;
    schema:domainIncludes sao:Constraint,
        sao:DatabaseConstraint ;
    schema:rangeIncludes sao:ConstraintType,
        sao:DatabaseConstraintType ;
    rdfs:comment "Type of constraint.",
        "[Constraint] Type of constraint.",
        "[DatabaseConstraint] The type of constraint." ;
    rdfs:isDefinedBy sao: .

sao:contained_in_unit a rdf:Property ;
    rdfs:label "contained_in_unit" ;
    schema:domainIncludes sao:CallableUnit,
        sao:DataElement,
        sao:DataStructure ;
    rdfs:comment "The parent encapsulation unit.",
        "[CallableUnit] The parent encapsulation unit.",
        "[DataElement] The parent encapsulation unit.",
        "[DataStructure] The parent encapsulation unit." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:EncapsulationUnit .

sao:contains_code_elements a rdf:Property ;
    rdfs:label "contains_code_elements" ;
    rdfs:comment "All code elements defined in this container.",
        "[CodeContainer] All code elements defined in this container." ;
    rdfs:domain sao:CodeContainer ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:contains_data_elements a rdf:Property ;
    rdfs:label "contains_data_elements" ;
    schema:domainIncludes sao:DataStructure,
        sao:EncapsulationUnit ;
    rdfs:comment "Fields or variables contained in this unit or structure.",
        "[DataStructure] Fields or variables contained in this unit or structure.",
        "[EncapsulationUnit] Fields or variables contained in this unit or structure." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataElement .

sao:contains_entries a rdf:Property ;
    rdfs:label "contains_entries" ;
    schema:domainIncludes sao:AuditLog,
        sao:Log ;
    schema:rangeIncludes sao:AuditEntry,
        sao:LogEntry ;
    rdfs:comment "[AuditLog] `AuditEntry[]` (v2.0 back-reference from `AuditEntry.entry_in_audit_log`).",
        "[Log] List of `LogEntry` records (inverse: `entry_in_log`).",
        "`AuditEntry[]` (v2.0 back-reference from `AuditEntry.entry_in_audit_log`)." ;
    rdfs:isDefinedBy sao: .

sao:created_at a rdf:Property ;
    rdfs:label "created_at" ;
    rdfs:domain sao:Metadata ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Timestamp .

sao:created_by a rdf:Property ;
    rdfs:label "created_by" ;
    rdfs:domain sao:Metadata ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:data_type a rdf:Property ;
    rdfs:label "data_type" ;
    schema:domainIncludes sao:Attribute,
        sao:DataElement,
        sao:UIProperty ;
    rdfs:comment "Data type (DEPRECATED for typed analysis -- use declared_type)",
        "[Attribute] Data type (string, integer, boolean, date, etc.).",
        "[DataElement] Data type (DEPRECATED for typed analysis -- use declared_type)",
        "[UIProperty] Property data type." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:default_value a rdf:Property ;
    rdfs:label "default_value" ;
    schema:domainIncludes sao:Attribute,
        sao:DataElement,
        sao:UIProperty ;
    rdfs:comment "Default value.",
        "[Attribute] Default value if not specified.",
        "[DataElement] Default value.",
        "[UIProperty] Default value." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:defined_in_container a rdf:Property ;
    rdfs:label "defined_in_container" ;
    schema:domainIncludes sao:CallableUnit,
        sao:DataStructure,
        sao:EncapsulationUnit ;
    rdfs:comment "Code container where this element is defined",
        "[CallableUnit] Code container where this element is defined",
        "[DataStructure] Code container where this element is defined",
        "[EncapsulationUnit] Code container where this element is defined" ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:CodeContainer .

sao:definition a rdf:Property ;
    rdfs:label "definition" ;
    schema:domainIncludes sao:Contract,
        sao:ContractVersion,
        sao:Schema,
        sao:SchemaVersion ;
    rdfs:comment "Schema definition (JSON Schema, DDL, etc.).",
        "[ContractVersion] Contract at this version.",
        "[Contract] Contract definition.",
        "[SchemaVersion] Schema at this version.",
        "[Schema] Schema definition (JSON Schema, DDL, etc.)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:description a rdf:Property ;
    rdfs:label "description" ;
    rdfs:comment "[NamedEntity] Free-text description." ;
    rdfs:domain sao:NamedEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:directive_type a rdf:Property ;
    rdfs:label "directive_type" ;
    schema:domainIncludes sao:ExecutionEnvironmentDirective,
        sao:PreprocessorDirective ;
    schema:rangeIncludes xsd:string,
        sao:MetaprogrammingType ;
    rdfs:comment "Type of directive.",
        "[ExecutionEnvironmentDirective] Type of directive.",
        "[PreprocessorDirective] The type of metaprogramming construct." ;
    rdfs:isDefinedBy sao: .

sao:effective_from a rdf:Property ;
    rdfs:label "effective_from" ;
    rdfs:comment "Version start date.",
        "[Versionable] Version start date." ;
    rdfs:domain sao:Versionable ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Timestamp .

sao:effective_to a rdf:Property ;
    rdfs:label "effective_to" ;
    rdfs:comment "Version end date.",
        "[Versionable] Version end date." ;
    rdfs:domain sao:Versionable ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Timestamp .

export:permissibleValue a rdf:Property ;
    rdfs:label "declared permissible value" ;
    rdfs:comment "Describes a LinkML enum value; does not impose a closed RDFS enumeration." .

sao:expression a rdf:Property ;
    rdfs:label "expression" ;
    schema:domainIncludes sao:Constraint,
        sao:DatabaseConstraint ;
    rdfs:comment "Constraint expression (e.g., \"hour >= 9 AND hour <= 17\").",
        "[Constraint] Constraint expression (e.g., \"hour >= 9 AND hour <= 17\").",
        "[DatabaseConstraint] Expression for CHECK constraints" ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:external_name a rdf:Property ;
    rdfs:label "external_name" ;
    schema:domainIncludes sao:FileDefinition,
        sao:ScreenDefinition ;
    rdfs:comment "External/physical file name (DD name, path)",
        "[FileDefinition] External/physical file name (DD name, path)",
        "[ScreenDefinition] External map/display file name" ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:failure_threshold a rdf:Property ;
    rdfs:label "failure_threshold" ;
    schema:domainIncludes sao:CircuitBreaker,
        sao:HealthCheck ;
    rdfs:comment "Number of failures before opening circuit.",
        "[CircuitBreaker] Number of failures before opening circuit.",
        "[HealthCheck] Failures before marking unhealthy." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:integer .

sao:format a rdf:Property ;
    rdfs:label "format" ;
    schema:domainIncludes sao:CodeContainer,
        sao:Dataset ;
    rdfs:comment "Format or language (DEPRECATED -- use written_in_language relationship)",
        "[CodeContainer] Format or language (DEPRECATED -- use written_in_language relationship)",
        "[Dataset] Data format (CSV, Parquet, etc.)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:framework a rdf:Property ;
    rdfs:label "framework" ;
    schema:domainIncludes sao:ComplianceRequirement,
        sao:ConcurrencyPattern,
        sao:MLModel,
        sao:StateStore,
        sao:TestSuite,
        sao:UIComponent ;
    schema:rangeIncludes xsd:string,
        sao:ComplianceFramework ;
    rdfs:comment "Compliance framework this requirement belongs to.",
        "[ComplianceRequirement] Compliance framework this requirement belongs to.",
        "[ConcurrencyPattern] Framework or library.",
        "[MLModel] ML framework (TensorFlow, PyTorch, etc.).",
        "[StateStore] State management framework (Redux, Vuex, Zustand, etc.).",
        "[TestSuite] Testing framework.",
        "[UIComponent] Framework (React, Angular, Vue, etc.)." ;
    rdfs:isDefinedBy sao: .

sao:has_constraints a rdf:Property ;
    rdfs:label "has_constraints" ;
    schema:domainIncludes sao:Collection,
        sao:Permission ;
    schema:rangeIncludes sao:Constraint,
        sao:DatabaseConstraint ;
    rdfs:comment "List of conditions that must be satisfied.",
        "[Collection] `DatabaseConstraint[]` (inlined) -- constraint definitions for this collection (see Section 27).",
        "[Permission] List of conditions that must be satisfied." ;
    rdfs:isDefinedBy sao: .

sao:has_file_operations a rdf:Property ;
    rdfs:label "has_file_operations" ;
    schema:domainIncludes sao:CallableUnit,
        sao:FileDefinition ;
    rdfs:comment "FileOperation[] performed by this callable.",
        "[CallableUnit] FileOperation[] performed by this callable.",
        "[FileDefinition] Operations performed on this file." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:FileOperation .

sao:has_steps a rdf:Property ;
    rdfs:label "has_steps" ;
    schema:domainIncludes sao:DataPipeline,
        sao:Workflow ;
    schema:rangeIncludes sao:DataPipelineStep,
        sao:Step ;
    rdfs:comment "Ordered list of `Step` entities.",
        "[DataPipeline] Pipeline steps.",
        "[Workflow] Ordered list of `Step` entities." ;
    rdfs:isDefinedBy sao: .

sao:has_subscriptions a rdf:Property ;
    rdfs:label "has_subscriptions" ;
    schema:domainIncludes sao:Actor,
        sao:EventInterface ;
    rdfs:comment "Subscriptions to this event interface.",
        "[Actor] `Subscription` entities owned by this actor.",
        "[EventInterface] Subscriptions to this event interface." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Subscription .

sao:has_versions a rdf:Property ;
    rdfs:label "has_versions" ;
    schema:domainIncludes sao:Contract,
        sao:Schema ;
    schema:rangeIncludes sao:ContractVersion,
        sao:SchemaVersion ;
    rdfs:comment "List of `SchemaVersion` entities.",
        "[Contract] List of contract versions.",
        "[Schema] List of `SchemaVersion` entities." ;
    rdfs:isDefinedBy sao: .

sao:id a rdf:Property ;
    rdfs:label "id" ;
    rdfs:comment "[NamedEntity] Unique identifier." ;
    rdfs:domain sao:NamedEntity ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:implemented_by_code a rdf:Property ;
    rdfs:label "implemented_by_code" ;
    rdfs:comment "Code implementations of this component.",
        "[Component] Code implementations of this component." ;
    rdfs:domain sao:Component ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:implements_component a rdf:Property ;
    rdfs:label "implements_component" ;
    schema:domainIncludes sao:CodeContainer,
        sao:EncapsulationUnit ;
    rdfs:comment "Architectural component implemented by this code.",
        "[CodeContainer] Architectural component implemented by this code.",
        "[EncapsulationUnit] Architectural component implemented by this code." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:Component .

sao:imported_via a rdf:Property ;
    rdfs:label "imported_via" ;
    schema:domainIncludes sao:CallableUnit,
        sao:DataStructure,
        sao:EncapsulationUnit ;
    rdfs:comment "Definition references importing this code element.",
        "[CallableUnit] Definition references importing this code element.",
        "[DataStructure] Definition references importing this code element.",
        "[EncapsulationUnit] Definition references importing this code element." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DefinitionReference .

sao:imports_symbols a rdf:Property ;
    rdfs:label "imports_symbols" ;
    rdfs:comment "Symbols imported by this definition reference.",
        "[DefinitionReference] Symbols imported by this definition reference." ;
    rdfs:domain sao:DefinitionReference ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:is_active a rdf:Property ;
    rdfs:label "is_active" ;
    schema:domainIncludes sao:Credential,
        sao:Rule ;
    rdfs:comment "[Credential] Whether the credential is currently active.",
        "[Rule] Whether rule is currently active." ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:boolean .

sao:is_current a rdf:Property ;
    rdfs:label "is_current" ;
    rdfs:comment "Whether this is the current version.",
        "[Versionable] Whether this is the current version." ;
