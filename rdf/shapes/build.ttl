        <https://ontologies.corestory.ai/sao/shapes/PipelineStage/environment_variables>,
        <https://ontologies.corestory.ai/sao/shapes/PipelineStage/id>,
        <https://ontologies.corestory.ai/sao/shapes/PipelineStage/is_manual>,
