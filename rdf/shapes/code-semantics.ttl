<https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of> a sh:PropertyShape ;
    sh:description "Code elements whose behavior is altered by this annotation." ;
    sh:or <https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternatives> ;
    sh:path sao:affects_behavior_of .

<https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternative/0> sh:class sao:EncapsulationUnit .

<https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternative/1> sh:class sao:CallableUnit .

<https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternatives> rdf:first <https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternative/0> ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternatives/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternatives/cell/1> rdf:first <https://ontologies.corestory.ai/sao/shapes/Annotation/affects_behavior_of/alternative/1> ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element> a sh:PropertyShape ;
    sh:description "Code elements bearing this annotation." ;
    sh:maxCount 1 ;
    sh:or <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives> ;
    sh:path sao:annotates_element .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/0> sh:class sao:EncapsulationUnit .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/1> sh:class sao:CallableUnit .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/2> sh:class sao:DataStructure .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/3> sh:class sao:DataElement .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives> rdf:first <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/0> ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives/cell/1> rdf:first <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/1> ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives/cell/2> rdf:first <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/2> ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternatives/cell/3> rdf:first <https://ontologies.corestory.ai/sao/shapes/Annotation/annotates_element/alternative/3> ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Annotation/annotation_syntax> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Syntax form (e.g., `@Override`, `#[derive(Debug)]`)." ;
    sh:maxCount 1 ;
    sh:path sao:annotation_syntax .

<https://ontologies.corestory.ai/sao/shapes/Annotation/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

