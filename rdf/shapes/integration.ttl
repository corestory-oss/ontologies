<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/10> rdf:first "corba" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/11> .

