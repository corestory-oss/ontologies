spec:AcceptanceCriterion a rdfs:Class ;
    rdfs:label "AcceptanceCriterion" ;
    rdfs:comment "A normative, checkable condition used to decide whether a requirement is satisfied." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:Claim .

spec:ArtifactFragment a rdfs:Class ;
    rdfs:label "ArtifactFragment" ;
    rdfs:comment "A section or fragment of a document that represents specific knowledge items." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:ChangeProposal a rdfs:Class ;
    rdfs:label "ChangeProposal" ;
    rdfs:comment "A proposed change to a specification baseline. It can represent a feature change or modernization while keeping current behavior separate from intent." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:Claim a rdfs:Class ;
    rdfs:label "Claim" ;
    rdfs:comment "An individually traceable statement. Origin, review, and confidence describe different aspects of the statement and must not substitute for each other." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:Decision a rdfs:Class ;
    rdfs:label "Decision" ;
    rdfs:comment "A recorded choice, including context, alternatives, rationale, and consequences. A decision record is a representation of this item." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:DecisionOption a rdfs:Class ;
    rdfs:label "DecisionOption" ;
    rdfs:comment "An alternative considered in a decision." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:EvidenceAnchor a rdfs:Class ;
    rdfs:label "EvidenceAnchor" ;
    rdfs:comment "A location within an immutable source snapshot. It is evidence offered for a statement, not proof of correctness or a confidence score." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:RepresentationProfile a rdfs:Class ;
    rdfs:label "RepresentationProfile" ;
    rdfs:comment "An identified external document convention, such as OpenSpec, arc42, MADR, or an organization’s PRD template. Declaring a profile does not implement an adapter or certify conformance." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:Requirement a rdfs:Class ;
    rdfs:label "Requirement" ;
    rdfs:comment "A normative obligation or intended behavior. Evidence that an implementation exhibits it is recorded separately as a descriptive claim or verification result." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:Claim .

spec:RequirementReplacement a rdfs:Class ;
    rdfs:label "RequirementReplacement" ;
    rdfs:comment "A proposed replacement of one requirement with another; neither version is silently overwritten." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:Scenario a rdfs:Class ;
    rdfs:label "Scenario" ;
    rdfs:comment "An example of behavior under stated conditions. It can describe existing behavior or desired behavior; provenance is carried by its linked claims." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:ScenarioStep a rdfs:Class ;
    rdfs:label "ScenarioStep" ;
    rdfs:comment "An ordered interaction in a scenario, connected to individually traceable statements." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:SourceSnapshot a rdfs:Class ;
    rdfs:label "SourceSnapshot" ;
    rdfs:comment "An identified state of a source repository, document, dataset, or execution capture. Revision must identify the captured state, not a moving branch name." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:SpecActivity a rdfs:Class ;
    rdfs:label "SpecActivity" ;
    rdfs:comment "A recorded extraction, authoring, review, generation, or verification activity with identified inputs and tool versions." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:SpecAgent a rdfs:Class ;
    rdfs:label "SpecAgent" ;
    rdfs:comment "A person, organization, or tool responsible for authoring, producing, or reviewing knowledge." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:SpecElement a rdfs:Class ;
    rdfs:label "SpecElement" ;
    rdfs:comment "An independently identified item of specification knowledge. Its identifier denotes this knowledge item, not the software entity it describes." ;
    rdfs:isDefinedBy spec: .

spec:Specification a rdfs:Class ;
    rdfs:label "Specification" ;
    rdfs:comment "A versioned collection of requirements, descriptive claims, scenarios, and decisions. It is distinct from the documents used to render it." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:SpecificationArtifact a rdfs:Class ;
    rdfs:label "SpecificationArtifact" ;
    rdfs:comment "A document or other presentation of specification knowledge. Its identity is distinct from the requirements, decisions, and software entities it discusses." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:SpecificationGraph a rdfs:Class ;
    rdfs:label "SpecificationGraph" ;
    rdfs:comment "An exchange envelope containing identified knowledge items and their references. Sources and software graphs may be stored separately." ;
    rdfs:isDefinedBy spec: .

spec:UseCase a rdfs:Class ;
    rdfs:label "UseCase" ;
    rdfs:comment "A goal-directed interaction described from a participant’s perspective. Participants are roles in the narrative, not a replacement for software identity classes." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:VerificationResult a rdfs:Class ;
    rdfs:label "VerificationResult" ;
    rdfs:comment "An observed outcome of checking a claim against a particular source state. Passing is scoped to this check and snapshot, not a universal assertion of equivalence." ;
    rdfs:isDefinedBy spec: ;
    rdfs:subClassOf spec:SpecElement .

spec:acceptance_criteria a rdf:Property ;
    rdfs:label "acceptance_criteria" ;
    schema1:domainIncludes spec:Requirement,
        spec:SpecificationGraph ;
    rdfs:comment "[Requirement] Checkable conditions for accepting satisfaction of this requirement.",
        "[SpecificationGraph] Inline records of AcceptanceCriterion items; relationships between records use their identifiers." ;
    rdfs:isDefinedBy spec: ;
    rdfs:range spec:AcceptanceCriterion .

spec:action a rdf:Property ;
