sao:TypeExpression a rdfs:Class ;
    rdfs:label "TypeExpression" ;
    rdfs:comment "A recursive type model for expressing complex types (generics, unions, pointers, function types, etc.) across all languages." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Replaces flat `data_type` strings with structured, queryable type information. Enables cross-language type analysis and compatibility checking." .

sao:base_type a rdf:Property ;
    rdfs:label "base_type" ;
    rdfs:comment "Base type name (e.g., \"List\", \"int\", \"String\")",
        "[TypeExpression] Base type name (e.g., \"List\", \"int\", \"String\")" ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:has_type_parameters a rdf:Property ;
    rdfs:label "has_type_parameters" ;
    rdfs:comment "Generic type parameters (e.g., T in List<T>)",
        "[TypeExpression] Generic type parameters (e.g., T in List<T>)" ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:TypeExpression .

sao:nullability_model a rdf:Property ;
    rdfs:label "nullability_model" ;
    rdfs:comment "How nullability is expressed (e.g., \"optional\", \"nullable\", \"Option<T>\")",
        "[TypeExpression] How nullability is expressed (e.g., \"optional\", \"nullable\", \"Option<T>\")" ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:pointer_semantics a rdf:Property ;
    rdfs:label "pointer_semantics" ;
    rdfs:comment "Pointer/reference semantics (e.g., \"raw\", \"smart\", \"weak\")",
        "[TypeExpression] Pointer/reference semantics (e.g., \"raw\", \"smart\", \"weak\")" ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:return_type_of_callables a rdf:Property ;
    rdfs:label "return_type_of_callables" ;
    rdfs:comment "Callables that return this type.",
        "[TypeExpression] Callables that return this type." ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:CallableUnit .

sao:type_constraints a rdf:Property ;
    rdfs:label "type_constraints" ;
    rdfs:comment "Constraints on type parameters",
        "[TypeExpression] Constraints on type parameters" ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range xsd:string .

sao:type_kind a rdf:Property ;
    rdfs:label "type_kind" ;
    rdfs:comment "The kind of type expression.",
        "[TypeExpression] The kind of type expression." ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:TypeKind .

sao:type_of_data_elements a rdf:Property ;
    rdfs:label "type_of_data_elements" ;
    rdfs:comment "Data elements that have this type.",
        "[TypeExpression] Data elements that have this type." ;
    rdfs:domain sao:TypeExpression ;
    rdfs:isDefinedBy sao: ;
    rdfs:range sao:DataElement .

sao:type_of_parameters a rdf:Property ;
    rdfs:label "type_of_parameters" ;
    rdfs:comment "Parameters that have this type.",
