spec:profile_uri a rdf:Property ;
    rdfs:label "profile_uri" ;
    rdfs:comment "[RepresentationProfile] Authoritative documentation for the convention." ;
    rdfs:domain spec:RepresentationProfile ;
    rdfs:isDefinedBy spec: ;
    rdfs:range xsd:anyURI .

spec:profile_version a rdf:Property ;
    rdfs:label "profile_version" ;
    rdfs:comment "[RepresentationProfile] External format version or documentation revision used for the mapping." ;
