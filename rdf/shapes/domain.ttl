        <https://ontologies.corestory.ai/sao/shapes/ResourceType/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/ResourceType/name>,
        <https://ontologies.corestory.ai/sao/shapes/ResourceType/structured_by_schema>,
        <https://ontologies.corestory.ai/sao/shapes/ResourceType/tags> ;
    sh:targetClass sao:ResourceType .

saosh:StateShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/State/allows_actions_in_state>,
        <https://ontologies.corestory.ai/sao/shapes/State/current_for_entities>,
        <https://ontologies.corestory.ai/sao/shapes/State/description>,
        <https://ontologies.corestory.ai/sao/shapes/State/id>,
        <https://ontologies.corestory.ai/sao/shapes/State/initial_for_lifecycle>,
        <https://ontologies.corestory.ai/sao/shapes/State/is_initial>,
        <https://ontologies.corestory.ai/sao/shapes/State/is_terminal>,
        <https://ontologies.corestory.ai/sao/shapes/State/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/State/name>,
        <https://ontologies.corestory.ai/sao/shapes/State/source_of_transitions>,
        <https://ontologies.corestory.ai/sao/shapes/State/tags>,
        <https://ontologies.corestory.ai/sao/shapes/State/target_of_transitions> ;
    sh:targetClass sao:State .

saosh:TransitionShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Transition/description>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/executes_actions_on_transition>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/guarded_by_rules>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/id>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/name>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/transitions_from_state>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/transitions_to_state>,
        <https://ontologies.corestory.ai/sao/shapes/Transition/triggered_by_events> ;
