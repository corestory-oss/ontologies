    sh:property <https://ontologies.corestory.ai/sao/shapes/Incident/affects_services>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/description>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/escalated_from_alerts>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/id>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/name>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/postmortem_url>,
        <https://ontologies.corestory.ai/sao/shapes/Incident/resolved_at>,
