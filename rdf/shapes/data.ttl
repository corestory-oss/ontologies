<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type> a sh:PropertyShape ;
    sh:description "Classification level." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:classification_type .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values> rdf:first "public" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/1> rdf:first "internal" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/2> rdf:first "confidential" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/3> rdf:first "restricted" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/4> rdf:first "pii" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/5> rdf:first "phi" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/DataClassification/classification_type/values/cell/6> rdf:first "pci" ;
    rdf:rest () .

