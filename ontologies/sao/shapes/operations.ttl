        <https://ontologies.corestory.ai/sao/shapes/DeploymentUnit/unit_type> ;
    sh:targetClass sao:DeploymentUnit .

saosh:EnvironmentShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Environment/deployed_by_pipelines>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/description>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/env_configured_by>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/environment_type>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/hosts_deployments>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/id>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Environment/name>,
