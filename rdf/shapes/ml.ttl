<https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/5> rdf:first "computer_vision" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/6> rdf:first "generative" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/7> .

<https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/7> rdf:first "reinforcement_learning" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/8> .

<https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/8> rdf:first "time_series" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/9> .

<https://ontologies.corestory.ai/sao/shapes/MLModel/model_type/values/cell/9> rdf:first "anomaly_detection" ;
    rdf:rest () .

