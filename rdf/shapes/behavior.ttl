        <https://ontologies.corestory.ai/sao/shapes/Action/executed_in_step>,
        <https://ontologies.corestory.ai/sao/shapes/Action/executes_in_transaction>,
        <https://ontologies.corestory.ai/sao/shapes/Action/id>,
        <https://ontologies.corestory.ai/sao/shapes/Action/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Action/name>,
        <https://ontologies.corestory.ai/sao/shapes/Action/performed_by_actor>,
        <https://ontologies.corestory.ai/sao/shapes/Action/recorded_in_audit>,
        <https://ontologies.corestory.ai/sao/shapes/Action/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Action/targets_resources>,
        <https://ontologies.corestory.ai/sao/shapes/Action/validated_by_action_rules> ;
    sh:targetClass sao:Action .

