<https://ontologies.corestory.ai/sao/shapes/Action/allowed_by_permissions> a sh:PropertyShape ;
    sh:class sao:Permission ;
    sh:description "`Permission` entities required." ;
    sh:path sao:allowed_by_permissions .

<https://ontologies.corestory.ai/sao/shapes/Action/allowed_in_states> a sh:PropertyShape ;
    sh:class sao:State ;
    sh:description "Back-reference to `State` entities that allow this action." ;
    sh:path sao:allowed_in_states .

<https://ontologies.corestory.ai/sao/shapes/Action/category> a sh:PropertyShape ;
    sh:description "`query` (read-only), `command` (state-changing), `mutation` (data modification)." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Action/category/values> ;
    sh:maxCount 1 ;
    sh:path sao:category .

<https://ontologies.corestory.ai/sao/shapes/Action/category/values> rdf:first "query" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Action/category/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Action/category/values/cell/1> rdf:first "command" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Action/category/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Action/category/values/cell/2> rdf:first "mutation" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Action/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Action/emits_events_from_action> a sh:PropertyShape ;
    sh:class sao:Event ;
    sh:description "`Event` entities emitted." ;
    sh:path sao:emits_events_from_action .

<https://ontologies.corestory.ai/sao/shapes/Action/executed_by_operation> a sh:PropertyShape ;
    sh:class sao:Operation ;
    sh:description "Back-reference to `Operation` entities that execute this action." ;
    sh:path sao:executed_by_operation .

<https://ontologies.corestory.ai/sao/shapes/Action/executed_during_transition> a sh:PropertyShape ;
    sh:class sao:Transition ;
    sh:description "Back-reference to `Transition` entities that execute this action." ;
    sh:path sao:executed_during_transition .

<https://ontologies.corestory.ai/sao/shapes/Action/executed_in_step> a sh:PropertyShape ;
    sh:class sao:Step ;
    sh:description "Back-reference to `Step` entities that execute this action." ;
    sh:path sao:executed_in_step .

<https://ontologies.corestory.ai/sao/shapes/Action/executes_in_transaction> a sh:PropertyShape ;
    sh:class sao:Transaction ;
    sh:description "`Transaction` context." ;
    sh:maxCount 1 ;
    sh:path sao:executes_in_transaction .

<https://ontologies.corestory.ai/sao/shapes/Action/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Action/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Action/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Action/performed_by_actor> a sh:PropertyShape ;
    sh:class sao:Actor ;
    sh:description "`Actor` performing the action." ;
    sh:maxCount 1 ;
    sh:path sao:performed_by_actor .

<https://ontologies.corestory.ai/sao/shapes/Action/recorded_in_audit> a sh:PropertyShape ;
    sh:class sao:AuditEntry ;
    sh:description "Back-reference to `AuditEntry` entities that record this action." ;
    sh:path sao:recorded_in_audit .

<https://ontologies.corestory.ai/sao/shapes/Action/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Action/targets_resources> a sh:PropertyShape ;
    sh:class sao:Resource ;
    sh:description "`Resource` entities affected." ;
    sh:path sao:targets_resources .

<https://ontologies.corestory.ai/sao/shapes/Action/validated_by_action_rules> a sh:PropertyShape ;
    sh:class sao:Rule ;
    sh:description "`Rule` entities that validate." ;
    sh:path sao:validated_by_action_rules .

<https://ontologies.corestory.ai/sao/shapes/Command/allowed_by_permissions> a sh:PropertyShape ;
    sh:class sao:Permission ;
    sh:description "`Permission` entities required." ;
    sh:path sao:allowed_by_permissions .

<https://ontologies.corestory.ai/sao/shapes/Command/allowed_in_states> a sh:PropertyShape ;
    sh:class sao:State ;
    sh:description "Back-reference to `State` entities that allow this action." ;
    sh:path sao:allowed_in_states .

<https://ontologies.corestory.ai/sao/shapes/Command/category> a sh:PropertyShape ;
    sh:description "`query` (read-only), `command` (state-changing), `mutation` (data modification)." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Command/category/values> ;
    sh:maxCount 1 ;
    sh:path sao:category .

<https://ontologies.corestory.ai/sao/shapes/Command/category/values> rdf:first "query" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/category/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Command/category/values/cell/1> rdf:first "command" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/category/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Command/category/values/cell/2> rdf:first "mutation" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type> a sh:PropertyShape ;
    sh:description "Kind of command." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Command/command_type/values> ;
    sh:maxCount 1 ;
    sh:path sao:command_type .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type/values> rdf:first "create" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/1> rdf:first "update" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/2> rdf:first "delete" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/3> rdf:first "execute" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/4> rdf:first "archive" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/Command/command_type/values/cell/5> rdf:first "restore" ;
    rdf:rest () .

