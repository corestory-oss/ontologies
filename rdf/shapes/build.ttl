    sh:datatype xsd:string ;
    sh:description "Kind of registry (Docker Hub, Nexus, ECR, etc.)." ;
    sh:maxCount 1 ;
    sh:path sao:registry_type .

<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/stores_artifacts> a sh:PropertyShape ;
    sh:class sao:BuildArtifact ;
    sh:description "Artifacts stored." ;
    sh:path sao:stores_artifacts .

<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_produced_by_pipeline> a sh:PropertyShape ;
