<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values> rdf:first "http" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol/values/cell/1> rdf:first "https" ;
