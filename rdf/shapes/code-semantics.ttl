        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/description>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/has_child_blocks>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/has_parent_block>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/id>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/line_end>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/line_start>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/name>,
        <https://ontologies.corestory.ai/sao/shapes/CodeBlock/tags> ;
    sh:targetClass sao:CodeBlock .

saosh:ControlFlowShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/ControlFlow/condition>,
        <https://ontologies.corestory.ai/sao/shapes/ControlFlow/description>,
