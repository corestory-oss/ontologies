sao:Constraint a rdfs:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A condition that must be satisfied for authorization" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Adds contextual or temporal restrictions to permissions." .

sao:Permission a rdfs:Class ;
    rdfs:label "Permission" ;
    rdfs:comment "A specific allowed action on a resource type or instance" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents atomic units of access that can be granted or denied." .

sao:Policy a rdfs:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A rule set governing access decisions" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Implements complex authorization logic that cannot be expressed through simple role-permission mappings." .

sao:Role a rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A named collection of permissions assignable to actors" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Groups permissions into meaningful job functions or responsibilities that can be assigned to identities." .

sao:Scope a rdfs:Class ;
    rdfs:label "Scope" ;
    rdfs:comment "A boundary limiting where a permission applies" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Restricts permissions to specific contexts, reducing the blast radius of access grants." .

