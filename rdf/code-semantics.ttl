sao:Annotation a rdfs:Class ;
    rdfs:label "Annotation" ;
    rdfs:comment "Metadata attached to code elements. Maps to: Annotations (Java), Decorators (Python), Attributes (C#), Pragmas (C/C++), Compiler directives." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:CodeBlock a rdfs:Class ;
    rdfs:label "CodeBlock" ;
    rdfs:comment "A logical grouping of statements within a callable unit." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:ControlFlow a rdfs:Class ;
    rdfs:label "ControlFlow" ;
    rdfs:comment "Represents control flow between code elements." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:DataFlow a rdfs:Class ;
    rdfs:label "DataFlow" ;
    rdfs:comment "Represents data flow between code elements." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:DefinitionReference a rdfs:Class ;
    rdfs:label "DefinitionReference" ;
    rdfs:comment "A reference from one code container to shared definitions. Maps to: Import (Python/Java), Include (C/C++), COPY (COBOL), Using (C#), Require (Ruby), Use (Rust)." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:ExecutionEnvironmentDirective a rdfs:Class ;
    rdfs:label "ExecutionEnvironmentDirective" ;
    rdfs:comment "Platform-specific execution directives. Maps to: JCL (mainframe), Docker Compose, Kubernetes manifests, Shell scripts, Makefiles, build files." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:PlatformExtension .

sao:PlatformExtension a rdfs:Class ;
    rdfs:label "PlatformExtension" ;
    rdfs:comment "Base class for platform-specific extensions" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:Statement a rdfs:Class ;
    rdfs:label "Statement" ;
    rdfs:comment "A single executable instruction or declaration." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:alias a rdf:Property ;
    rdfs:label "alias" ;
    rdfs:comment "Import alias.",
