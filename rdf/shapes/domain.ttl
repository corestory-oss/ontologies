saosh:ValueObjectShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/ValueObject/belongs_to_aggregate>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/description>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/has_attributes>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/id>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/mapped_from_structure_vo>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/name>,
        <https://ontologies.corestory.ai/sao/shapes/ValueObject/tags> ;
    sh:targetClass sao:ValueObject .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/aggregate_documented_by_artifacts> a sh:PropertyShape ;
    sh:class sao:KnowledgeArtifact ;
    sh:path sao:aggregate_documented_by_artifacts .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/aggregates_entities> a sh:PropertyShape ;
    sh:class sao:DomainEntity ;
    sh:description "`DomainEntity` instances within this aggregate." ;
    sh:path sao:aggregates_entities .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/contained_in_bounded_context> a sh:PropertyShape ;
    sh:class sao:BoundedContext ;
    sh:description "Parent `BoundedContext`." ;
    sh:maxCount 1 ;
    sh:path sao:contained_in_bounded_context .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/enforced_by_invariant_rules> a sh:PropertyShape ;
    sh:class sao:Rule ;
    sh:description "`Rule` entities that enforce aggregate invariants." ;
    sh:path sao:enforced_by_invariant_rules .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/has_root_entity> a sh:PropertyShape ;
    sh:class sao:DomainEntity ;
    sh:description "The root `DomainEntity` (required, single)." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:has_root_entity .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/has_value_objects> a sh:PropertyShape ;
    sh:class sao:ValueObject ;
    sh:description "List of value objects within the aggregate." ;
    sh:path sao:has_value_objects .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/persisted_in_stores> a sh:PropertyShape ;
    sh:class sao:DataStore ;
    sh:description "`DataStore` entities where this aggregate is persisted." ;
    sh:path sao:persisted_in_stores .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/produces_domain_events> a sh:PropertyShape ;
    sh:class sao:DomainEvent ;
    sh:description "`DomainEvent` entities produced." ;
    sh:path sao:produces_domain_events .

<https://ontologies.corestory.ai/sao/shapes/Aggregate/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Attribute/category> a sh:PropertyShape ;
    sh:description "`required`, `optional`, `computed`, `derived`, `transient`." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Attribute/category/values> ;
    sh:maxCount 1 ;
    sh:path sao:category .

<https://ontologies.corestory.ai/sao/shapes/Attribute/category/values> rdf:first "required" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/1> rdf:first "optional" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/2> rdf:first "computed" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/3> rdf:first "derived" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/category/values/cell/4> rdf:first "transient" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification> a sh:PropertyShape ;
    sh:description "Data classification (`public`, `internal`, `confidential`, `pii`, etc.)." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values> ;
    sh:maxCount 1 ;
    sh:path sao:classification .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values> rdf:first "public" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/1> rdf:first "internal" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/2> rdf:first "confidential" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/3> rdf:first "restricted" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/4> rdf:first "pii" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/5> rdf:first "phi" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/Attribute/classification/values/cell/6> rdf:first "pci" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/Attribute/data_type> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Data type (string, integer, boolean, date, etc.)." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:data_type .

<https://ontologies.corestory.ai/sao/shapes/Attribute/default_value> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Default value if not specified." ;
    sh:maxCount 1 ;
    sh:path sao:default_value .

<https://ontologies.corestory.ai/sao/shapes/Attribute/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
