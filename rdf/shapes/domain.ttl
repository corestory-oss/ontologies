        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/is_composition>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/is_navigable>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/join_entity>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/name>,
        <https://ontologies.corestory.ai/sao/shapes/DomainRelationship/tags> ;
    sh:targetClass sao:DomainRelationship .

saosh:LifecycleShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Lifecycle/description>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/governs_entities>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/has_states>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/has_transitions>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/id>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/name>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/starts_with_state>,
        <https://ontologies.corestory.ai/sao/shapes/Lifecycle/tags> ;
    sh:targetClass sao:Lifecycle .

saosh:ResourceShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Resource/affected_in_audit>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/classified_as_type>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/description>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/id>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/name>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/represents_entity>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Resource/targeted_by_actions> ;
