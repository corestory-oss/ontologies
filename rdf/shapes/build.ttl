<https://ontologies.corestory.ai/sao/shapes/BuildPipeline/pipeline_type/values> rdf:first "build" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildPipeline/pipeline_type/values/cell/1> .

