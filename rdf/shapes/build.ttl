<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/name> a sh:PropertyShape ;
