saosh:IntegrationShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Integration/belongs_to_system>,
        <https://ontologies.corestory.ai/sao/shapes/Integration/description>,
