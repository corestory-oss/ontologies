sao:BoundedContext a rdfs:Class ;
    rdfs:label "BoundedContext" ;
    rdfs:comment "A semantic boundary within which a domain model applies consistently. Corresponds to DDD bounded context concept." ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Isolates domain models to prevent ambiguity and maintain consistency within a specific business domain or subdomain." .

sao:Capability a rdfs:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "A discrete business or technical ability the system provides" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents what the system can do, abstracting the implementation details." .

sao:Component a rdfs:Class ;
    rdfs:label "Component" ;
    rdfs:comment "A logical building block within a module (class, function group, etc.)" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity .

sao:Dependency a rdfs:Class ;
    rdfs:label "Dependency" ;
    rdfs:comment "A lightweight dependency reference between components or services" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Documents dependencies for build, deployment, and runtime management." .

sao:Endpoint a rdfs:Class ;
    rdfs:label "Endpoint" ;
    rdfs:comment "A specific addressable entry point on a service" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents a concrete API endpoint or service entry point." .

sao:EventInterface a rdfs:Class ;
    rdfs:label "EventInterface" ;
    rdfs:comment "Event-driven interface" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:Interface ;
    skos:note "Event-driven asynchronous interface." .

sao:Feature a rdfs:Class ;
    rdfs:label "Feature" ;
    rdfs:comment "A user-facing manifestation of one or more capabilities" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Represents functionality as perceived by end users or consumers of the system." .

sao:Interface a rdfs:Class ;
    rdfs:label "Interface" ;
    rdfs:comment "A contract-defined boundary through which interaction occurs" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity ;
    skos:note "Defines how actors and systems interact with the application." .

sao:Module a rdfs:Class ;
    rdfs:label "Module" ;
    rdfs:comment "A deployable, cohesive unit of functionality within a bounded context" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:NamedEntity,
        sao:Versionable ;
    skos:note "Provides a logical grouping of related components that can be independently versioned and deployed." .

sao:ProgrammaticInterface a rdfs:Class ;
    rdfs:label "ProgrammaticInterface" ;
    rdfs:comment "Machine-to-machine interface" ;
    rdfs:isDefinedBy sao: ;
    rdfs:subClassOf sao:Interface ;
