@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sao: <https://ontologies.corestory.ai/sao/> .
@prefix saosh: <https://ontologies.corestory.ai/sao/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

saosh:ActorShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Actor/audit_actions_performed>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/category>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/description>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/has_identities>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/id>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/name>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/owns_controls>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/owns_subscriptions>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/performs_actions>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Actor/verifies_evidence> ;
    sh:targetClass sao:Actor .

saosh:CredentialShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Credential/credential_for_identity>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/credential_type>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/description>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/expires_at>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/id>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/is_active>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/name>,
        <https://ontologies.corestory.ai/sao/shapes/Credential/tags> ;
    sh:targetClass sao:Credential .

saosh:HumanActorShape a sh:NodeShape ;
