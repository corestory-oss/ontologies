<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/base_url> a sh:PropertyShape ;
    sh:datatype xsd:anyURI ;
    sh:description "Registry base URL." ;
    sh:maxCount 1 ;
    sh:path sao:base_url .

<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/ArtifactRegistry/is_private> a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:description "Whether the registry is private." ;
