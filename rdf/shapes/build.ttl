    sh:class sao:ArtifactRegistry ;
    sh:description "Registry storing this artifact." ;
    sh:maxCount 1 ;
    sh:path sao:artifact_stored_in_registry .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type> a sh:PropertyShape ;
    sh:description "Kind of artifact." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:artifact_type .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values> rdf:first "container_image" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/1> rdf:first "binary" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/2> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/2> rdf:first "archive" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/3> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/3> rdf:first "package" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/4> rdf:first "library" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/5> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/5> rdf:first "documentation" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/6> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/6> rdf:first "report" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/7> .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_type/values/cell/7> rdf:first "load_module" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/BuildArtifact/artifact_uri> a sh:PropertyShape ;
    sh:datatype xsd:anyURI ;
    sh:description "Artifact location." ;
    sh:maxCount 1 ;
    sh:path sao:artifact_uri .

