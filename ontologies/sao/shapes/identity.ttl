<https://ontologies.corestory.ai/sao/shapes/SystemActor/actor_type/values/cell/3> rdf:first "ai_agent" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/SystemActor/actor_type/values/cell/4> .

<https://ontologies.corestory.ai/sao/shapes/SystemActor/actor_type/values/cell/4> rdf:first "message_trigger" ;
    rdf:rest () .

<https://ontologies.corestory.ai/sao/shapes/SystemActor/audit_actions_performed> a sh:PropertyShape ;
    sh:class sao:AuditEntry ;
    sh:description "`AuditEntry` entities recording actions by this actor." ;
    sh:path sao:audit_actions_performed .

<https://ontologies.corestory.ai/sao/shapes/SystemActor/category> a sh:PropertyShape ;
    sh:description "Actor category (`human`, `system`)." ;
    sh:in <https://ontologies.corestory.ai/sao/shapes/SystemActor/category/values> ;
    sh:maxCount 1 ;
    sh:path sao:category .

<https://ontologies.corestory.ai/sao/shapes/SystemActor/category/values> rdf:first "human" ;
    rdf:rest <https://ontologies.corestory.ai/sao/shapes/SystemActor/category/values/cell/1> .

<https://ontologies.corestory.ai/sao/shapes/SystemActor/category/values/cell/1> rdf:first "system" ;
    rdf:rest () .

