    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Infrastructure/used_by_environments> a sh:PropertyShape ;
    sh:class sao:Environment ;
    sh:description "`Environment` entities using this infrastructure." ;
    sh:path sao:used_by_environments .

<https://ontologies.corestory.ai/sao/shapes/Release/changelog> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Release notes describing changes." ;
    sh:maxCount 1 ;
    sh:path sao:changelog .

<https://ontologies.corestory.ai/sao/shapes/Release/deployed_in_deployments_as_release> a sh:PropertyShape ;
    sh:class sao:Deployment ;
    sh:description "`Deployment` entities that deploy this release." ;
    sh:path sao:deployed_in_deployments_as_release .

<https://ontologies.corestory.ai/sao/shapes/Release/description> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Free-text description." ;
    sh:maxCount 1 ;
    sh:path sao:description .

<https://ontologies.corestory.ai/sao/shapes/Release/effective_from> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Version start date." ;
    sh:maxCount 1 ;
    sh:path sao:effective_from .

<https://ontologies.corestory.ai/sao/shapes/Release/effective_to> a sh:PropertyShape ;
    sh:datatype xsd:dateTime ;
    sh:description "Version end date." ;
    sh:maxCount 1 ;
    sh:path sao:effective_to .

<https://ontologies.corestory.ai/sao/shapes/Release/has_artifacts> a sh:PropertyShape ;
    sh:class sao:DeploymentUnit ;
    sh:description "List of `DeploymentUnit` entities." ;
    sh:path sao:has_artifacts .

<https://ontologies.corestory.ai/sao/shapes/Release/id> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Unique identifier." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:id .

<https://ontologies.corestory.ai/sao/shapes/Release/is_current> a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:description "Whether this is the current version." ;
    sh:maxCount 1 ;
    sh:path sao:is_current .

<https://ontologies.corestory.ai/sao/shapes/Release/metadata> a sh:PropertyShape ;
    sh:class sao:Metadata ;
    sh:description "Created/updated timestamps and version." ;
    sh:maxCount 1 ;
    sh:path sao:metadata .

<https://ontologies.corestory.ai/sao/shapes/Release/name> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Human-readable name." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path sao:name .

<https://ontologies.corestory.ai/sao/shapes/Release/tags> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Freeform tags." ;
    sh:path sao:tags .

<https://ontologies.corestory.ai/sao/shapes/Release/version> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:description "Semantic version number." ;
    sh:maxCount 1 ;
    sh:path sao:version ;
    sh:pattern "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$" .
