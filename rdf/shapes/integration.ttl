saosh:AdapterShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/Adapter/component_documented_by_artifacts>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/component_serves_model>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/component_type>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/component_uses_concurrency_pattern>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/contained_in_module>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/description>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/emits_events>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/emits_metric>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/emits_metrics>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/exposes_operations>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/generates_logs>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/has_coverage>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/has_dependencies>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/id>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/implemented_by_code>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/language>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/metadata>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/name>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/source_location>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/source_protocol>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/tags>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/target_protocol>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/tested_by_suites>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/transformation>,
        <https://ontologies.corestory.ai/sao/shapes/Adapter/used_by_integrations> ;
    sh:targetClass sao:Adapter .

saosh:CircuitBreakerShape a sh:NodeShape ;
    sh:closed false ;
    sh:property <https://ontologies.corestory.ai/sao/shapes/CircuitBreaker/description>,
        <https://ontologies.corestory.ai/sao/shapes/CircuitBreaker/failure_threshold>,
        <https://ontologies.corestory.ai/sao/shapes/CircuitBreaker/half_open_requests>,
        <https://ontologies.corestory.ai/sao/shapes/CircuitBreaker/id>,
        <https://ontologies.corestory.ai/sao/shapes/CircuitBreaker/metadata>,
