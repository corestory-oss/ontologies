    rdfs:label "change_proposals" ;
    rdfs:comment "[SpecificationGraph] Inline records of ChangeProposal items; relationships between records use their identifiers." ;
    rdfs:domain spec:SpecificationGraph ;
    rdfs:isDefinedBy spec: ;
